vities.contribution.editAnActivity":"Edit an Activity","activities.contribution.submitActivityForReview":"Submit activity for review","activities.contribution.submitEdits":"Submit edits","activities.contribution.contactInformation":"Contact Information","activities.contribution.authors":"Authors","activities.contribution.authorNames":"Author Names","activities.contribution.contactEmail":"Contact Email","activities.contribution.emailDescription":"Email is for internal use only, so activity reviewers can contact you about your contribution.","activities.contribution.publishEmailOptional":"Display contact email on the published activity page (Optional).","activities.contribution.activityFiles":"Activity Files","activities.contribution.activityFilesDescription":"Provide at least one local and/or online file. Note: it is against PhET’s trademark <a {{0}}>licensing</a> to use the PhET logo in your documents, except for when it appears in sim screenshots.","activities.contribution.localFiles":"Local Files","activities.contribution.giveYourFilesDescriptive":"Give your files descriptive and unique names before uploading. Supported file types: pdf, doc, docx, ppt, pptx, xls, xlsx, txt, cck, esp, notebook, mbz, codap.","activities.contribution.uploadFile":"Upload File","activities.contribution.onlineFiles":"Online Files","activities.contribution.onlineFilesDescription":"Give your linked resource a descriptive and unique link text. Supported online formats: PocketLab Notebook, CODAP Lab, and Google Docs, Sheets, Slides or Forms.","activities.contribution.resourceTitle":"Resource Title","activities.contribution.resourcesUrl":"Resource URL","activities.contribution.addLink":"Add Link","activities.contribution.removeFile":"Remove {{file}}","activities.contribution.noFilesAdded":"No Files Added","activities.contribution.includedTeacherSupports":"Included Teacher Supports","activities.contribution.includedTeacherSupportsDescription":"Let others know if your contribution includes a lesson plan and/or answers.","activities.contribution.includesLessonPlan":" Includes Lesson Plan","activities.contribution.includesAnswers":"Includes Answers","activities.contribution.activityInformation":"Activity Information","activities.contribution.activityTitle":"Activity Title","activities.contribution.activityTitleDescription":"Give your activity a specific and unique title.","activities.contribution.title":"Title","activities.contribution.simulations":"Simulations","activities.contribution.simName":"Sim name","activities.contribution.simulationLimit":"You may only select up to 5 related simulations per activity","activities.contribution.simulationsDescription":"Select the simulations associated with your activity, up to a maximum of five.","activities.contribution.removeSimulation":"Remove {{simulation_name}}","activities.contribution.topics":"Topics","activities.contribution.topic":"Topic","activities.contribution.topicsDescription":"Select at least one relevant topic, up to a maximum of three. Topics help teachers find relevant activities.","activities.contribution.removeTopic":"Remove {{topic}}","activities.contribution.topicRequest":"Request","activities.contribution.learningGoals":"Learning Goals","activities.contribution.learningGoal":"Learning Goal","activities.contribution.learningGoalsDescription":"Include at least one learning goal, up to a maximum of five. Most activities have two to three learning goals.","activities.contribution.learningGoalsTip":"Effective learning goals are specific and measurable.","activities.contribution.tipsForWritingLearningGoals":"Tips for writing learning goals","activities.contribution.learningGoalN":"Learning Goal {{number}}","activities.contribution.removeLearningGoalN":"Remove Learning Goal {{number}}","activities.contribution.addLearningGoal":"Add learning goal","activities.contribution.activityDescription":"Activity Description","activities.contribution.descriptionDescription":"Describe the focus, flow, and/or learning strategies used in this activity. Use this space to note any major updates to the activity after initial publication. Please enter a minimum of 50 characters.","activities.contribution.categories":"Categories","activities.contribution.categoriesDescription":"Choose the most relevant subjects, grade levels, activity types, and settings for your activity.","activities.contribution.categoriesTip":"For help with choosing categories:","activities.contribution.whatAreActivityTypes":"What are activity types?","activities.contribution.whatAreActivitySettings":"What are activity settings?","activities.contribution.subjects":"Subjects","activities.contribution.gradeLevels":"Grade Levels","activities.contribution.types":"Types","activities.contribution.discussionPrompts":"Discussion Prompts","activities.contribution.interactiveDemonstration":"Interactive Demonstration","activities.contribution.conceptQuestions":"Concept Questions","activities.contribution.activitySheet":"Activity Sheet","activities.contribution.settings":"Settings","activities.contribution.wholeClass":"Whole Class","activities.contribution.smallGroup":"Small Group","activities.contribution.individual":"Individual","activities.contribution.lab":"Lab","activities.contribution.homework":"Homework","activities.contribution.remote":"Remote","activities.contribution.duration":"Duration","activities.contribution.language":"Language","activities.contribution.standardsAlignment":"Standards Alignment","activities.contribution.commonCoreMathUSA":"Common Core Standards - Math","activities.contribution.selectStandards":"Select Standards","activities.contribution.licensingAgreement":"Licensing Agreement","activities.contribution.licensingAgreementIAgree":"I have read the above and I agree to license this content under its terms","activities.contribution.meetsRequirementsIAgree":"I agree that my activity has met the publishable requirements in the <a {{0}}>self-evaluation rubric</a>, and give the PhET review team permission to make minor edits as part of the review process.","activities.contribution.uploadingActivity":"We're uploading your activity to our database. Please wait.","activities.contribution.ensureYoureReady":"Ensure You’re Ready to Contribute an Activity","activities.contribution.beSureToUseTheSelfEvaluationRubric":"Be sure to use the <a {{0}}>Self-evaluation Rubric</a> to ensure your activity meets the publishable or gold-star requirements.","activities.contribution.contributionRelatedFAQsAreAvailable":"Contribution-related FAQs are available on the <a {{0}}>Contribution Guidelines Page</a>.","activities.contribution.activityGuidelines":"Activity Guidelines","activities.contribution.goodFileNamesHelp":"Good file names help users identify the activity components.","activities.contribution.uploadingAnEditableVersion":"Uploading an editable version of your activity makes it easy for other users to modify your activity for their class.","activities.contribution.goodExamples":"Good Examples","activities.contribution.badExamples":"Bad Examples","activities.contribution.example":"Example","activities.contribution.exampleFileTitle1":"Parallel Lines Student Worksheet","activities.contribution.exampleFileTitle2":"Parallel Lines Teacher Guide","activities.contribution.phetLesson":"PhET Lesson","activities.contribution.teacherGuide":"Teacher Guide","activities.contribution.aGoodActivityTitle":"A good activity title will provide context about the focus of the activity.","activities.contribution.goodExample":"Good Example","activities.contribution.goodExampleTitle1":"Discovering current and voltage patterns in series and parallel circuits","activities.contribution.notFindingARelevantTopic":"Not finding a relevant topic?","activities.contribution.requestATopic":"Request a topic","activities.contribution.errors.authorsRequired":"List contributing authors.","activities.contribution.errors.contactEmailRequired":"Provide a contact email. Email will not be displayed without consent.","activities.contribution.errors.descriptionRequired":"Provide a more detailed description. A minimum of 50 characters is required.","activities.contribution.errors.resourceTitleRequired":"Provide a title for your online resource.","activities.contribution.errors.activityTitleRequired":"Provide a specific and unique title for your activity.","activities.contribution.errors.creativeCommonsRequired":"You must agree to the licensing terms to submit your activity.","activities.contribution.errors.meetsRequirementsRequired":"You must agree to having completed a self review to submit your activity.","activities.contribution.errors.localeRequired":"A language selection is required.","activities.contribution.errors.atLeastOneTopicIsRequired":"Select at least one topic.","activities.contribution.errors.durationRequired":"Select an activity duration.","activities.contribution.errors.learningGoalsRequired":"Provide at least one learning goal.","activities.contribution.errors.simulationsRequired":"Choose at least one simulation that relates to your activity.","activities.contribution.errors.atMost5SimulationsAllowed":"You may only select up to 5 simulations. Please remove some simulations.","activities.contribution.errors.settingRequired":"Choose at least one setting.","activities.contribution.errors.typeRequired":"Choose at least one activity type.","activities.contribution.errors.gradeLevelRequired":"Choose at least one grade level.","activities.contribution.errors.subjectRequired":"Choose at least one subject.","activities.contribution.errors.filesOrDocsRequired":"Provide at least one local file or a link to an online file.","activities.contribution.errors.filesMustHaveUniqueNames":"Provide unique filenames.","activities.contribution.errors.urlsMustBeUnique":"Provide unique URLs.","activities.contribution.errors.unsupportedResource":"This URL is not a supported resource. Provide a valid URL for a CODAP Lab, PocketLab Notebook, Google Doc, Sheet, Slide, or Form","activities.contribution.errors.unsupportedFileType":"This file type is not supported.","activities.contribution.errors.resourceMustHaveUrl":"A URL must be provided for this online resource.","activities.contribution.errors.pleaseFix":"Please fix the following errors:","activities.contribution.conflict.activitySubmissionConflict":"Activity Submission Conflict","activities.contribution.conflict.description":"This activity was changed by another user while you were editing it.  The changes were unable to be merged successfully. Please refresh the page and enter your changes again.","activities.contribution.success.activitySubmitted":"Activity Submitted","activities.contribution.success.editsSubmitted":"Edits Submitted","activities.contribution.success.thankYouForYourContribution":"Thank you for your contribution! <a {{href}}>View your activity</a>.","activities.contribution.success.thankYouForSubmittingEdits":"Thank you for submitting edits! <a {{href}}>View your activity</a>.","activities.contribution.success.checkReviewStatus":"You can check the review status of this activity and other activities you've contributed by going to <a {{href}}>My Contributions</a>.","activities.contribution.success.allActivitiesGoThrough":"All activities go through a peer-review process before publication. This process may take up to one month. Read more about the evaluation process at <a {{href}}>Activity Contribution Guidelines</a>."}}},"activity-page":{"ActivitiesQuickControlPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v;n.export({ActivitiesQuickControlPanel:()=>S},!0),n.link("react",{default(e){i=e},useEffect(e){o=e},useState(e){r=e}},0),n.link("website-common/geo",{LocaleInfo(e){a=e}},1),n.link("../../LocaleContext",{useLocale(e){s=e}},2),n.link("../../../../components/phetText/PhetText",{H2(e){l=e},P(e){c=e}},3),n.link("../../../../../api/urlUtils",{externalHrefProps(e){u=e}},4),n.link("../common/editAndDeleteButton/EditAndDeleteButton",{EditAndDeleteButton(e){m=e}},5),n.link("..