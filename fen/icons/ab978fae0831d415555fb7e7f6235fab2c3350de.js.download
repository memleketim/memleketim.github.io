ctivity)),i.createElement("section",{className:"sidebar"},i.createElement("img",{className:"img",src:`${r}/lessons-icon.png`,alt:""}),i.createElement("h2",{className:"h4 title"},t.activities.contributionGuidelines.usingPhetInClassrooms.title),i.createElement("p",{className:"p text"},i.createElement(g,{string:t.activities.contributionGuidelines.usingPhetInClassrooms.text,interpolatedValues:{href:u(S.getLink(e))}}))),i.createElement("section",{className:"sidebar"},i.createElement("img",{className:"img",src:`${r}/notebook-icon.png`,alt:""}),i.createElement("h2",{className:"h4 title"},t.activities.contributionGuidelines.newToWritingActivities.title),i.createElement("p",{className:"p text"},i.createElement(g,{string:t.activities.contributionGuidelines.newToWritingActivities.text,interpolatedValues:{href:u(k.getLink(e))}}))))))}),{sections:N,evaluationHref:A,getLink:(e,t)=>`${a}/${e}/activities/contribution-guidelines${t?`?section=${t}`:""}`})},"activityContributionGuidelinesPageStrings.json":function(e,t,n){n.exports={"nav.activities.contributionGuidelines":"Activity Contribution Guidelines","activities.contributionGuidelines.title":"Activity Contribution Guidelines","activities.contributionGuidelines.contributionRequirements":"Activity Contribution Requirements","activities.contributionGuidelines.minimumRequirements":"Minimum Requirements","activities.contributionGuidelines.requirement1.v2":"Substantial use of a PhET sim as the primary learning tool","activities.contributionGuidelines.requirement2.v2":"Scientific and/or mathematical accuracy","activities.contributionGuidelines.requirement3.v2":"Unique and original, and/or gives appropriate attribution","activities.contributionGuidelines.requirement4.v2":"Achieves a “Publishable” rating in the <a {href}>self-evaluation rubric</a>.","activities.contributionGuidelines.goldStarRequirements":"Gold Star Requirements","activities.contributionGuidelines.goldStar1.v2":"An exemplar sim-based activity that achieves one or more of the following:","activities.contributionGuidelines.goldStar1.a":"Promotes active learning and inquiry in alignment with <a {href}>PhET’s Active Learning principles</a>","activities.contributionGuidelines.goldStar1.b":"Leverages strategies promoted in the <a {href}>PhET Virtual Workshop</a>","activities.contributionGuidelines.goldStar1.c":"Advances equity by aligning with <a {href}>PhET’s Framework for Equity</a>","activities.contributionGuidelines.goldStar1.d":"Incorporates research-based methodologies for science and math","activities.contributionGuidelines.goldStar2.v2":"Questioning strategies that support rich investigation, discussion, and student agency (i.e. avoids prescriptive instructions)","activities.contributionGuidelines.goldStar3.v2":"Achieves a “Publish with Gold Star” rating in the <a {href}>self-evaluation rubric</a>.","activities.contributionGuidelines.goldStarRecognition":"These activities are recognized with a gold star ⭐, displaying them at the top of activity search results.","activities.contributionGuidelines.faq.title":"Frequently Asked Questions","activities.contributionGuidelines.faq.whatIsAnActivity.question":"What is an activity?","activities.contributionGuidelines.faq.whatIsAnActivity.answer":"Activities refer to any general kind of teacher-created instructional support to be used with a PhET simulation. An activity may include documentation for how to carry out instruction using whole-class strategies, small group or individual strategies.","activities.contributionGuidelines.faq.whyContribute.question":"Why contribute an activity?","activities.contributionGuidelines.faq.whyContribute.answer1":"PhET simulations are effective learning tools that make learning science and math enjoyable and empowering. For sims to be most effective, they need a well-designed activity paired with them that addresses specific learning goals and guides the learning.","activities.contributionGuidelines.faq.whyContribute.answer2":"If you have designed an activity, we want you to share it with other teachers to use!","activities.contributionGuidelines.faq.whyContribute.answer3":"When you contribute an activity to the PhET website, you may experience:","activities.contributionGuidelines.faq.whyContribute.answer4a":"Opportunities to improve your activity:","activities.contributionGuidelines.faq.whyContribute.answer4b":"The activity gets <a {href}>evaluated</a> in a peer-review process with teachers from all over the world. This evaluation process could help you identify how your activity can be improved.","activities.contributionGuidelines.faq.whyContribute.answer5a":"Impact beyond your classroom:","activities.contributionGuidelines.faq.whyContribute.answer5b":"If your activity is accepted for publication, it will be available to hundreds of thousands of teachers around the world to use. You will have access to data on how many people bookmark and download your activity.","activities.contributionGuidelines.faq.whyContribute.answer6a":"International recognition:","activities.contributionGuidelines.faq.whyContribute.answer6b":"PhET is recognized for creating high-quality resources and making science and math accessible to everybody, and you can be part of that! You can request a certificate as a PhET Activity Author for each of your submissions, and your activity may be promoted in our monthly email and our social media.","activities.contributionGuidelines.faq.whyContribute.answer7a":"Being part of the PhET Educators Community:","activities.contributionGuidelines.faq.whyContribute.answer7b":"Although you may not interact directly with other PhET authors, or with teachers who use your activities, you are sharing outside your institution, and facilitating broader knowledge and experience exchange. You become an active and contributing member of the PhET Educator Community.","activities.contributionGuidelines.faq.whyContribute.answer8":"Your contribution is important for students and teachers:","activities.contributionGuidelines.faq.whyContribute.answer9a":"Exchange of Best Practices:","activities.contributionGuidelines.faq.whyContribute.answer9b":"Sharing activities allows teachers to exchange methods and strategies that have proven effective, helping to improve overall teaching practices.","activities.contributionGuidelines.faq.whyContribute.answer10a":"Innovation and Creativity:","activities.contributionGuidelines.faq.whyContribute.answer10b":"By seeing the activities other teachers are implementing, new ideas and creative approaches to curriculum content can be generated.","activities.contributionGuidelines.faq.whyContribute.answer11a":"Time Savings:","activities.contributionGuidelines.faq.whyContribute.answer11b":"Creating high-quality activities can be time consuming. If you are investing time in designing and testing an activity, other teachers will find value in using your activity with their students. Likewise, you will find other high-quality activities in the database that will save you time, so you can focus on teaching and supporting your students.","activities.contributionGuidelines.faq.whatAreTheSteps.question":"What are the steps for contributing an activity?","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.question":"What is the activity evaluation process?","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.part1":"The evaluation process is evolving in order to improve the quality of new activity contributions. The activity review team may use a <a {{href}}>self-evaluation rubric</a> to evaluate your activity and provide feedback.","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.part2":"After the initial evaluation, authors may receive an email with the result of the evaluation process and specific feedback, and the activity status will change from “Submitted” to one of the following statuses:","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.status1b":": A review team member is actively reviewing your activity with the self-evaluation rubric.","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.status2b":": You must address the comments in the emailed feedback to achieve a “publishable” rating. Once you have made the required changes, edit your contribution and click “submit activity for review.” The evaluation process will begin again. If the necessary changes are not made within 2 weeks, the contribution will not be approved.","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.status3b":": Your activity is approved and will be immediately published. You can choose to make improvements to your activity based on the emailed feedback and re-submit for consideration of a gold star.","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.status3c":"If your activity also received a gold star, it will be posted near the top of activity search results with other gold star activities.","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.part3":"Activities that are not approved will be deleted from the website, along with any related files.","activities.contributionGuidelines.faq.whatIsTheEvaluationProcess.part4":"To see the status of and edit your contributions, go to <a {{href}}>My Contributions</a>.","activities.contributionGuidelines.faq.whatAreActivityTypes.question":"What are activity types?","activities.contributionGuidelines.faq.whatAreActivityTypes.type1a":"Discussion Prompts:","activities.contributionGuidelines.faq.whatAreActivityTypes.type1b":"Questions that promote the exploration of principles through whole-class discussion.","activities.contributionGuidelines.faq.whatAreActivityTypes.type1c":"Whole-Class Inquiry Guidelines + Examples.","activities.contributionGuidelines.faq.whatAreActivityTypes.type2a":"Interactive Demonstration:","activities.contributionGuidelines.faq.whatAreActivityTypes.type2b":"Questions that accompany an interactive lecture demonstration to promote predictions and hypotheses.","activities.contributionGuidelines.faq.whatAreActivityTypes.type2c":"Interactive Lecture Demonstration Guidelines + Examples.","activities.contributionGuidelines.faq.whatAreActivityTypes.type3a":"Concept Questions:","activities.contributionGuidelines.faq.whatAreActivityTypes.type3b":"Questions in multiple-choice format to be used with groups of students.","activities.contributionGuidelines.faq.whatAreActivityTypes.type3c":"Concept Question Guidelines + Examples.","activities.contributionGuidelines.faq.whatAreActivityTypes.type4a":"Activity Sheet:","activities.contributionGuidelines.faq.whatAreActivityTypes.type4b":"A guided inquiry activity with direct student access to simulations.","activities.contributionGuidelines.faq.whatAreActivityTypes.type4c":"Activity Sheet Design Guidelines.","activities.contributionGuidelines.faq.whatAreActivitySettings.question":"What are activity settings?","activities.contributionGuidelines.faq.whatAreActivitySettings.setting1a":"Whole Class:","activities.contributionGuidelines.faq.whatAreActivitySettings.setting1b":"Students engage as a whole class with a simulation that is displayed via a projector, interactive whiteboard, or shared screen.","activities.contributionGuidelines.faq.whatAreActivitySettings.setting1c":"Whole Class Example","activities.contributionGuidelines.faq.whatAreActivitySettings.setting2a":"Small Group:","activities.contributionGuidelines.faq.whatAreActivitySettings.setting2b":"Students engage with a simulation in a group while having direct access to simulations on a singular or shared device during class.","activities.contributionGuidelines.faq.whatAreActivitySettings.setting2c":"Small Group Example","activities.contributionGuidelines.faq.whatAreActivitySettings.setting3a":"Individual:","activities.contributionGuidelines.faq.whatAreActivitySettings.setting3b":"Students engage with a simulation individually on their own device during class.","activities.contributionGuidelines.faq.whatAreActivitySettings.setting3c":"Individual Example","activities.contributionGuidelines.faq.whatAreActivitySettings.setting4a":"Lab:","activities.contributionGuidelines.faq.whatAreActivitySettings.setting4b":"Activity that can be used in conjunction with or as a replacement for a lab experience.","activities.contributionGuidelines.faq.whatAreActivitySettings.setting4c":"Lab Example.","activities.contributionGuidelines.faq.whatAreActivitySettings.setting5a":"Homework:","activities.contributionGuidelines.faq.whatAreActivitySettings.setting5b":"Activities that students complete outside of class that have continuity with in-class instruction.","activities.contributionGuidelines.faq.whatAreActivitySettings.setting5c":"Homework Example","activities.contributionGuidelines.faq.whatAreActivitySettings.setting6a":"Online/Remote Learning:","activities.contributionGuidelines.faq.whatAreActivitySettings.setting6b":"Activities suited to distance learning.","activities.contributionGuidelines.faq.whatAreActivitySettings.setting6c":"Remote Learning Example","activities.contributionGuidelines.faq.licensing.question":"How are my activities licensed for shared use?","activities.contributionGuidelines.faq.licensing.answer":"Approved activity contributions are published as Open Access Resources with a <a {{href}}>Creative Commons Attribution License</a>. This allows others to use, distribute, and create derivative works while still allowing authors to receive credit for their efforts. All authors must accept the Licensing Agreement before submitting an activity. ","activities.contributionGuidelines.faq.editOrDelete.question":"Can I edit or delete my contribution?","activities.contributionGuidelines.faq.editOrDelete.part1":"Yes! Go to <a {{href}}>My Contributions</a> and click on the pencil icon to edit, and the trash can icon to delete. If you edit a published activity, it will continue to be visible on the PhET website.","activities.contributionGuidelines.faq.editOrDelete.part2":"If you edit a published activity and hope your edits will lead to a gold star activity, you have the option to request that your activity be evaluated again.","activities.contributionGuidelines.faq.editOrDelete.part3":"If you delete an activity, the contribution and all related files will be deleted from the website. It is not possible to undo this action.","activities.contributionGuidelines.faq.question5":"Can I get a certificate for my contribution?","activities.contributionGuidelines.faq.answer5":"Request a certificate validating the successful publication of your activities by submitting an <a {{href}}>Activity Publication Certificate Request</a> Form.","activities.contributionGuidelines.contributionSteps.step1":"Log into your account (you must be <a {{href}}>registered on the PhET website</a>).","activities.contributionGuidelines.contributionSteps.step2":"Go to the <a {{href}}>contribution form</a>.","activities.contributionGuidelines.contributionSteps.step3":"Enter the required information","activities.contributionGuidelines.contributionSteps.step4":"Check the status of your activity at <a {{href1}}>My Contributions</a> while your activity undergoes a community <a {{href2}}>evaluation</a> process.","activities.contributionGuidelines.contributionSteps.step5":"Receive an email from {{emailAddress}} with feedback and an update on the status.","activities.contributionGuidelines.readyToSubmit":"Ready to upload your activity?","activities.contributionGuidelines.contributeAnActivity":"Contribute an Activity","activities.contributionGuidelines.usingPhetInClassrooms.title":"Using PhET in your classroom?","activities.contributionGuidelines.usingPhetInClassrooms.text":"Browse PhET <a {{href}}>sim-based activities</a> contributed by teachers around the globe.","activities.contributionGuidelines.newToWritingActivities.title":"New to writing activities?","activities.contributionGuidelines.newToWritingActivities.text":"Take PhET’s self-paced <a {{href}}>Virtual Workshop</a> to get a deep-dive on best practices for writing PhET sim-based activities."}}},filter:{"ActivitiesCancelFilterButtons.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d;n.export({ActivitiesCancelFilterButtons:()=>h},!0),n.link("lodash",{default(e){i=e}},0),n.link("react",{default(e){o=e}},1),n.link("react-helmet-async",{Helmet(e){r=e}},2),n.link("../../../../../api/data/constants",{IMG_ROOT(e){a=e}},3),n.link("../../../../../api/strings/useStrings",{useStrings(e){s=e}},4),n.link("website-common/geo",{localize(e){l=e}},5),n.link("../../../../components/filterPanel/filterCategoryStrings.json",{default(e){c=e}},6),n.link("../../LocaleContext",{useLocale(e){u=e}},7),n.link("./activitiesCancelFilterButtonsStrings.json",{default(e){m=e}},8),n.link("../../../../../api/strings/strings",{Strings(e){d=e}},9);let p=e=>o.createElement("li",null,o.createElement("button",{onClick:()=>e.cancelFilter(e.type,e.name),"aria-label":e.ariaLabel},e.children,o.createElement("img",{alt:"",className:"open",src:`${a}/plus-icon.png`}))),h=e=>{let t=u(),n=s(c),h=s(m),g=(t,n)=>{let o=i.cloneDeep(e.filters);if("searchLocale"===t)o.searchLocale=null;else if(o[t]){let e=o[t].findIndex(e=>e===n);e>=0&&o[t].splice(e,1)}e.filterActivities({filters:o})};function y(e,t,n,i){var r;null==(r=e[n])||r.forEach(e=>{e&&t.push(o.createElement(p,{key:t.length,name:e,type:n,cancelFilter:g,ariaLabel:d.fillIn(h.activities.cancelFilterButtons.remove,[i(e)])},o.createElement("span",null,i(e))))})}let f=e.filters,b=[];if(f.searchLocale){let t=f.searchLocale,n=e.simLocales[t],i=n&&(n[t]||n.name);b.push(o.createElement(p,{key:b.length,name:f.searchLocale,type:"searchLocale",cancelFilter:g,ariaLabel:d.fillIn(h.activities.cancelFilterButtons.remove,[i])},o.createElement("span",null,i)))}return["subjects","levels","activityTypes","settings","durations","approvals","a11yFeatures"].forEach(e=>y(f,b,e,e=>n.nav[e])),y(f,b,"sims",n=>{var i,o;let r=null==(i=e.projects.find(e=>e.simulations[0].name===n))?void 0:i.simulations[0].localizedSimulations,a=(null==(o=l(r||{},t))?void 0