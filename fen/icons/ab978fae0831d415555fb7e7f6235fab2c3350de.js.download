talled on devices, we would not be dependent on connectivity at school or when students go home. This will allow us to serve all of our students away from school, especially those who do not have connections at home.","deibInStemEd.programs.quote2":"Our community is in a rural setting where, thanks to COVID, it was discovered that some areas aren't within reach for any internet service. I feel having the PhET apps downloaded onto student devices will allow for students to have better engagement in the lesson and less frustration with loading issues.","deibInStemEd.programs.whereWeWork":"Where we work","deibInStemEd.programs.whereWeWorkDescription":"The program has provided mobile app access to {{number_of_students}} students across urban, rural, and suburban contexts.","deibInStemEd.programs.whoWeWorkWith":"Who we work with","deibInStemEd.programs.whoWeWorkWithDescription1":"This program supports K-12 schools that are eligible for Title 1 funds or the Community Eligibility Provision.","deibInStemEd.programs.whoWeWorkWithDescription2":"In line with our DEIB commitments, PhET aims to serve a diverse student population.","deibInStemEd.programs.howToGetInvolved":"How to get involved","deibInStemEd.programs.howToGetInvolvedDescription1":"Contact us to learn more about your school’s eligibility: <a {{0}}>phet4schools@colorado.edu</a>","deibInStemEd.programs.howToGetInvolvedDescription2":"If your school is not eligible for this program, please consider requesting a quote on our <a {{0}}>Apps for Schools</a> page.","deibInStemEd.programs.suburban":"Suburban","deibInStemEd.programs.rural":"Rural","deibInStemEd.programs.urban":"Urban","deibInStemEd.programs.highIncome":"High Income","deibInStemEd.programs.mediumIncome":"Medium Income","deibInStemEd.programs.lowIncome":"Low Income","deibInStemEd.programs.veryLowIncome":"Very Low Income","deibInStemEd.programs.black":"Black","deibInStemEd.programs.mixed":"Mixed","deibInStemEd.programs.asian":"Asian","deibInStemEd.programs.hawaiianPacificIslander":"Hawaiian/Pacific Islander","deibInStemEd.programs.americanIndian":"American Indian","deibInStemEd.programs.unknown":"Unknown","deibInStemEd.programs.white":"White","deibInStemEd.programs.latinx":"Latinx"}}},strategy:{"DeibInStemEdStrategyPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m;n.export({DeibInStemEdStrategyPanel:()=>d},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../../api/strings/useStrings",{useStrings(e){o=e}},1),n.link("../../../../../api/urlUtils.js",{getInlineExternalHref(e){r=e}},2),n.link("../../../../components/phetText/PhetText",{H2(e){a=e},H3(e){s=e},P(e){l=e},Span(e){c=e}},3),n.link("../../../../components/richString/RichString",{RichString(e){u=e}},4),n.link("./deibInStemEdStrategyPanelStrings.json",{default(e){m=e}},5);let d={panel:()=>{let e=o(m);return i.createElement("div",{className:"initiatives-panel strategy-panel"},i.createElement("section",{className:"section"},i.createElement(a,null,e["deib-in-stem-ed"].strategy.strategicPlanHeader),i.createElement(l,null,i.createElement(u,{string:e["deib-in-stem-ed"].strategy.strategicPlanDescription.v2,interpolatedValues:{href:r("https://docs.google.com/document/d/1zbDLK1RwTVcr04uLk2v11aEuTCJLHUz1FVkgnSuDq2c/edit#heading=h.mjqtnzwol1f7")}})),i.createElement(s,null,e["deib-in-stem-ed"].strategy.recommendationsHeader),i.createElement("ul",{className:"ul"},i.createElement("li",{className:"p"},i.createElement("b",null,e["deib-in-stem-ed"].strategy.recommendation.list1.header),i.createElement("br",null),e["deib-in-stem-ed"].strategy.recommendation.list1.description),i.createElement("li",{className:"p"},i.createElement("b",null,e["deib-in-stem-ed"].strategy.recommendation.list2.header),i.createElement("br",null),e["deib-in-stem-ed"].strategy.recommendation.list2.description),i.createElement("li",{className:"p"},i.createElement("b",null,e["deib-in-stem-ed"].strategy.recommendation.list3.header),i.createElement("br",null),e["deib-in-stem-ed"].strategy.recommendation.list3.de