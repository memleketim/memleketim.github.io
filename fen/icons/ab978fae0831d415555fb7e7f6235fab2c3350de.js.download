ork.accessibilityDescription))),i.createElement("section",{className:"minor-section"},i.createElement(u,null,e["deib-in-stem-ed"].strategy.equityFrameworkHeader),i.createElement(m,null,i.createElement(p,{string:e["deib-in-stem-ed"].strategy.equityFrameworkDescription1,interpolatedValues:{href1:l(y.getLink(t)),href2:s("https://docs.google.com/document/d/1UHrvXQG7NjHKZF-ALIzw5e-NgQcYUVb2qTT3EW53fEc/edit#heading=h.u2jbx1lscp2z"),href3:s("https://docs.google.com/document/d/1UHrvXQG7NjHKZF-ALIzw5e-NgQcYUVb2qTT3EW53fEc/edit#heading=h.w3nuhygfg8km"),href4:s("https://docs.google.com/document/d/1UHrvXQG7NjHKZF-ALIzw5e-NgQcYUVb2qTT3EW53fEc/edit#heading=h.otn9ntw8t1ct"),href5:s("https://docs.google.com/document/d/1UHrvXQG7NjHKZF-ALIzw5e-NgQcYUVb2qTT3EW53fEc/edit#heading=h.pksh3cowcj2x"),href6:s("https://docs.google.com/document/d/1UHrvXQG7NjHKZF-ALIzw5e-NgQcYUVb2qTT3EW53fEc/edit#heading=h.aq7syb1qj6x4")}})),i.createElement("br",null),i.createElement(m,{id:"equity-framework-description"},e["deib-in-stem-ed"].strategy.equityFrameworkDescription2),i.createElement("img",{className:"equity-framework-img",src:t.startsWith("es")?`${o}/equity-framework_es.png`:t.startsWith("pt")?`${o}/equity-framework_pt_BR.png`:`${o}/equity-framework.png`,alt:e["deib-in-stem-ed"].strategy.equityFrameworkAltText}))))},path:b,getLink:e=>`${r}/${e}/${f.path}/${b}`}},"deibInStemEdFrameworkPanelStrings.json":function(e,t,n){n.exports={"deib-in-stem-ed.strategy.header":"Defining DEIB in STEM Education","deib-in-stem-ed.strategy.description.v2":"DEIB refers to commitment to a set of values associated with systemic integrity and institutional respect for the human person. PhET adopts the following initial definitions (taken from <a {{href}}>ChalkBeat’s Statement on Diversity, Equity, Inclusion & Belonging</a>), and foresees evolution as our DEIB initiative work continues:","deib-in-stem-ed.strategy.diversity":"Diversity","deib-in-stem-ed.strategy.diversityDescription":"Encompassing a wide range of identities, including race, ethnicity, gender, age, national origin, religion, disability, sexuality, socioeconomic status, education, marital status, language, veteran status, physical appearance, political ideology, life experiences, etc.","deib-in-stem-ed.strategy.equity":"Equity","deib-in-stem-ed.strategy.equityDescription":"Fair treatment, access, opportunity, and advancement for all people, while acknowledging that there are historically exploited, underserved, and underrepresented populations, and striving to identify and eliminate barriers that have prevented the full participation of some groups.","deib-in-stem-ed.strategy.inclusion":"Inclusion","deib-in-stem-ed.strategy.inclusionDescription":"An environment in which any individual or group can be and feel welcomed, respected, supported, and valued as a fully participating member; one that embraces differences and respects all people.","deib-in-stem-ed.strategy.belonging":"Belonging","deib-in-stem-ed.strategy.belongingDescription":"The feeling that an individual is an important member of a group; that one readily identifies as a member of the group and feels a sense of connection, security, and affinity within it.","deib-in-stem-ed.strategy.frameworkHeader":"PhET's Framework for Equity in STEM Education","deib-in-stem-ed.strategy.frameworkDescription":"PhET is working with DEIB advisors and strategists to define what equity-aligned teaching and learning resources and programs should look like at PhET and in classrooms that make use of PhET simulations.","deib-in-stem-ed.strategy.equityPointsHeader":"Equity Themes","deib-in-stem-ed.strategy.equityPointsDescription":"PhET anchors its work on three themes to evaluate the action that PhET is taking to achieve DEIB:","deib-in-stem-ed.framework.relevanceHeader":"Relevance","deib-in-stem-ed.framework.relevanceDescription":"PhET aspires to be rooted in real-world phenomena and/or scenarios that consider localized and global perspectives to demonstrate how STEM is applicable to everyday life and can be used to propagate positive change and justice.","deib-in-stem-ed.framework.representationHeader":"Representation","deib-in-stem-ed.framework.representationDescription":"PhET aspires to embed mirrors that inherently allow users–especially those from historically marginalized communities–to authentically see themselves as instrumental members of the STEM community. It also aspires to embed windows that inherently allow users–especially those from historically dominant communities–to access additional authentic perspectives of who can and has engaged in STEM. Combined, PhET hopes that these mirrors and windows will engender a paradigm shift in the current narrative about who belongs in STEM.","deib-in-stem-ed.framework.accessibilityHeader":"Accessibility","deib-in-stem-ed.framework.accessibilityDescription":"PhET aspires to ensure that STEM concepts and practices, and PhET’s resources, are accessible to all individuals of diverse abilities and learning differences to ensure that all users have equal learning opportunities.","deib-in-stem-ed.strategy.equityFrameworkHeader":"Equity Framework","deib-in-stem-ed.strategy.equityFrameworkDescription1":"PhET's Equity Framework sits within the context of PhET's <a {{href1}}>DEIB in STEM Education initiative</a>, which includes its <a {{href2}}>Vision</a>, <a {{href3}}>Mission</a>, <a {{href4}}>DEIB-Related Mission Objectives</a>, <a {{href5}}>Values</a>, and broader commitment to <a {{href6}}>DEIB</a>. All of these elements of the initiative undergird all aspects of the framework. We also provide special attention to relevance, representation, and accessibility as our anchoring themes for assessing where we are on our journey to achieve equity through our resources and programs.","deib-in-stem-ed.strategy.equityFrameworkDescription2":"PhET's Equity Framework is composed of three layers that represent the scope of our work, enveloped by three equity themes that represent our commitment to working toward achieving equity for all learners and their teachers. The layers include PhET simulations at the core, which are embedded within PhET's sim-based supports, which are in turn embedded within PhET's professional development. The three layers are held together by a commitment to the equity themes of relevance, representation, and accessibility. Each of the layers in PhET's scope of work are equally influenced by the need for relevance, representation, and accessibility–albeit they may look different in the varying context of PhET's resources and programming.","deib-in-stem-ed.strategy.equityFrameworkAltText":"A sphere with three layers, labeled PhET simulations at the core, surrounded by PhET sim-based supports, which is surrounded by PhET teacher professional development. The entire sphere is wrapped in overlapping ribbons, labeled with Relevance, Representation, and Accessibility."}}},programs:{"DeibInStemEdProgramsPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d;n.export({DeibInStemEdProgramsPanel:()=>p},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../../api/data/constants",{IMG_ROOT(e){o=e}},1),n.link("../../../../../api/strings/useStrings",{useStrings(e){r=e}},2),n.link("../../../../../api/urlUtils.js",{getInlineExternalHref(e){a=e}},3),n.link("../../../../components/phetText/PhetText",{H2(e){s=e},H3(e){l=e},P(e){c=e}},4),n.link("../../../../components/quoteBlock/QuoteBlock",{QuoteBlock(e){u=e}},5),n.link("../../../../components/richString/RichString",{RichString(e){m=e}},6),n.link("./deibInStemEdProgramsPanelStrings.json",{default(e){d=e}},7);let p={panel:()=>{let e=r(d),t=[{statement:e.deibInStemEd.programs.quote1,attribution:"Deanna O"},{statement:e.deibInStemEd.programs.quote2,attribution:"Wendy F"}];return i.createElement(i.Fragment,null,i.createElement("div",{className:"initiatives-panel programs-panel"},i.createElement("section",{className:"section"},i.createElement(s,null,e.deibInStemEd.programs.header),i.createElement(c,null,e.deibInStemE