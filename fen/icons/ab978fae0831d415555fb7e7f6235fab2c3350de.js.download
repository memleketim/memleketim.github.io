ualWorkshop.fourFunctionBuilder",ev="virtualWorkshop.describeHowSymmetry",eS="virtualWorkshop.usingTheWheel",eP="virtualWorkshop.fiveUnitRates",ek="virtualWorkshop.lookForPatterns",eE="virtualWorkshop.putABagOfApples",ew="virtualWorkshop.lessonPlanTemplate",eT="virtualWorkshop.common.scienceActivityDesignCreateYour",eO="virtualWorkshop.common.videos",eI="virtualWorkshop.common.readings",eC="virtualWorkshop.common.videosAndReadingContent",eL="virtualWorkshop.common.reflectionsAndDiscussions",ej="virtualWorkshop.common.ifYouHaveAnyQuestions",ex="virtualWorkshop.common.whatMakesAPhetSimulation",eA="virtualWorkshop.common.isInternetConnectivityAChallenge",eN="virtualWorkshop.common.whichSimulationsDidYouTry",eD="virtualWorkshop.common.whatScienceConceptsDidYou",eM="virtualWorkshop.common.howMightYouLinkThe",eR="virtualWorkshop.common.howWouldYouUseThese",eF="virtualWorkshop.common.activeLearningWithSims",e_="virtualWorkshop.common.toGetTheBestOutOfPhet",eB="virtualWorkshop.common.integrationTips",eW="virtualWorkshop.common.hereAreSomeTipsTo",eK="virtualWorkshop.common.phetPowerPointAddInPhet",eU="virtualWorkshop.common.phetInOneNoteDocumentsPhet",eH="virtualWorkshop.common.sharingSims",eq="virtualWorkshop.common.theNewPhetHtmlSimulations",eG="virtualWorkshop.common.toShareAnHtmlOr",eY="virtualWorkshop.common.areaBuilderLink",e$="virtualWorkshop.common.toShareAJavaSim",ez="virtualWorkshop.common.alphaDecayLink",eV="virtualWorkshop.common.youCanModifyTheUrl",eQ="virtualWorkshop.common.youCanAlsoEmbedThe",eJ="virtualWorkshop.common.inCanvasUseEmbedCode",eZ="virtualWorkshop.common.inMoodleMultiStepHow",eX="virtualWorkshop.common.inEdulasticFormativeUseEmbedCode",e1="virtualWorkshop.common.content",e0="virtualWorkshop.common.content",e2="virtualWorkshop.common.nowItsYourTurn",e3="virtualWorkshop.common.conclusion",e5="virtualWorkshop.common.nextSteps",e4="virtualWorkshop.common.allVirtualWorkshops",e7="virtualWorkshop.common.mathematicsActivityDesignCreateYour",e6="virtualWorkshop.common.openPlayWithSims",e9="virtualWorkshop.common.nowThatYouveExploredThe",e8="virtualWorkshop.common.whatCanYouDoWith",te="virtualWorkshop.common.whatQuestionsDoYouHave",tt="virtualWorkshop.common.studentActivitySheet",tn="virtualWorkshop.common.lessonStructure",ti="virtualWorkshop.common.isThisYourFirstTime",to="virtualWorkshop.common.physicsLightAndFilters",tr="virtualWorkshop.common.physicsLightAndFiltersActivity",ta="virtualWorkshop.common.physicsLightAndFiltersTeacher",ts="virtualWorkshop.common.biologyNaturalSelectionPre",tl="virtualWorkshop.scienceActivityDesign.biologyNaturalSelectionActivitySheet",tc="virtualWorkshop.common.biologyNaturalSelectionTeacherGuide",tu="virtualWorkshop.common.chemistryMeasuringPHPre",tm="virtualWorkshop.common.chemistryMeasuringPHActivitySheet",td="virtualWorkshop.common.chemistryMeasuringPHTeacherGuide",tp="virtualWorkshop.common.takeAMomentToSummarize",th="virtualWorkshop.common.howWillYouTakeWhat",tg="virtualWorkshop.common.whatAreTheMainIdeas",ty="virtualWorkshop.common.facilitatingPhEtSimulationUsePrepare",tf=[h,y,g],tb={[i]:"Overview",[o]:"Goals",[r]:"Format",[a]:"Total Time",[s]:"Activities",[eO]:"Videos",[eI]:"Readings",[l]:"Part 1",[c]:"Introduction to PhET",[u]:"If you’re not familiar with PhET, this lecture will provide a brief overview of the history and goals of the PhET project.",[m]:"Part 2",[d]:"Part 3",[p]:"4-7 hours",[h]:"minutes",[g]:"hour",[y]:"hours",[f]:"Back to navigation",[b]:"An iframe with the {{0}} simulation is embedded below. The simulation is not yet accessible.",[v]:"Challenge Prompt Exercise",[P]:"Try modifying the prompt to be more open-ended but still achieve the same learning goal.",[S]:"How could you modify the prompt so that it is open-ended, but still reaches the learning goal?",[k]:"Teach & Reflect",[E]:"Submit Your Activity",[w]:"Tell Us What You Think",[T]:"Learning Goal:",[O]:"Original Prompt:",[I]:"New Prompt:",[eC]:"Readings",[eL]:"Reflections and discussions",[ej]:"<span {{class}}>If you have any questions</span>, please email us at <a {{link}}>phet-workshops@colorado.edu</a>",[ex]:"What makes a PhET simulation unique? Watch the next video to discover more about how PhET sims are designed and tested.",[eA]:"Is internet connectivity a challenge for you and your students? PhET has offline options that you can review in the “<a {{link}}>Offline Access</a>” section of our website. There you will find the link to download our app installer for Desktop/Laptop computers, which allows you to use the simulations even when you do not have Internet access. You will also find the link to the Apple AppStore and Google PlayStore to download our new smartphone and tablet apps.",[C]:"Play with Sims",[L]:"Physics",[j]:"Chemistry",[x]:"Earth & Space",[A]:"Biology",[N]:"Math & Statistics",[eN]:"Which simulations did you try using?",[eD]:"What mathematics or science concepts did you identify in each simulation?",[eM]:"How might you link the simulation with your own objectives for student learning in your classes?",[eR]:"How would you use these simulations with your students?",[eF]:"Active Learning with Sims",[e_]:"To get the most out of PhET simulations and enhance student learning, the simulations need to be used with active learning methodologies.",[eB]:"Integration Tips",[eW]:"Here are some tips to customize a simulation and integrate it within other information technologies that facilitate the use of PhET in lectures. Please review the following information:",[eK]:"<span {{class}}>PhET PowerPoint Add-In:</span> PhET sims can now be DIRECTLY embedded into your PowerPoint slides!",[eU]:"<span {{class}}>PhET in OneNote Documents:</span> PhET sims can now be DIRECTLY embedded in your OneNote document. Just copy the URL of the sim, paste it in any OneNote document, and that’s it! Instead of a URL, the simulations will be displayed and ready to use. Modify the size of the simulation and use the rest of the document to write or draw anything that you need to make your lecture more engaging.",[eH]:"Sharing Sims",[eq]:"The new PhET HTML5 simulations can be used on all electronic devices (e.g. computers, cell phones, and tablets). This technology makes it easier for students to learn by interacting and discovering.",[eG]:"To share an HTML5 or Java via CheerpJ sim, a good practice is to send your students a direct link (i.e. the URL of a sim you have opened). Here’s an example of a sim URL:",[eY]:"https://phet.colorado.edu/sims/html/area-builder/latest/area-builder_en.html",[e$]:"To share a Java sim, send your students a direct link to the .jar file to download and open. To send this link, right-click the ‘Download’ button and copy the link.",[ez]:"https://phet.colorado.edu/sims/nuclear-physics/alpha-decay_en.jar",[eV]:"You can modify the URL of a simulation to customize the number and order of screens within the PhET sim. Please see the following video:",[eQ]:"You can also embed the simulation by using an iframe. Copy-paste the embed code accessible on the sim webpage, clicking the code symbol that is under the sim’s name. Please review the following tutorials on how to integrate PhET sims on different platforms:",[eJ]:"In Canvas: use embed code (video tutorial)",[eZ]:"In Moodle: multi-step (how to document)",[eX]:"In Edulastic/Formative: use embed code (video tutorial)",[e1]:"Content",[e0]:"Workshop",[e2]:"Now It’s Your Turn!",[e3]:"Conclusion",[e5]:"Next Steps",[e4]:"All Virtual Workshops",[D]:"Now that you’ve learned a bit about PhET, it’s time to have some fun with simulations! The purpose of this time is to explore simulations as a student would, noticing features you discover within the sim and questions you have about it. Try out 4-5 different math simulations and write down your thoughts.",[M]:"Sample Activity",[R]:"Now, it’s time to step into the role of a student and work through a PhET activity. This will give you an understanding of what it is like to experience a simulation for the first time and how you might progress through it, so you can understand what your students will be going through in your activity.",[F]:"Imagine you are a 7th grade math student - you know how to identify integers as positive or negative, you can plot integers on a number line, and you understand absolute value as the distance from zero. Today, you’ll use Build an Atom to use this knowledge in the context of atomic charge.",[_]:"Begin by openly playing around with the simulation for about 5 minutes. Figure out how to use it, find the controls, and take note of what kind of questions you have. We call this “open play time”.",[B]:"Now that you’ve gotten to know the sim, listen to how a discussion following open play time with students may be facilitated.",[e6]:"Open Play with Sims",[e9]:"Now that you’ve explored the sim,",[e8]:"What can you do with this sim?",[te]:"What questions do you have?",[W]:"What does the teacher do here to make all student contributions feel valued?",[K]:"Atomic Addition Activity",[tt]:"Student Activity Sheet",[tn]:"Lesson Structure",[U]:"<span {{class}}>Open play:</span> students playing with the sim and learning how to use the sim without guidance",[H]:"<span {{class}}>Share-out:</span> students share how to use the sim and discoveries they made with teacher facilitating",[q]:"<span {{class}}>Activity sheet:</span> students work through open-ended challenge prompts that encourage multiple correct answers",[G]:"<span {{class}}>Discussion and check-in:</span> students pause periodically to discuss with peers or the whole class while the teacher circulates and checks in with individuals and groups",[Y]:"<span {{class}}>Summary discussion:</span> teacher facilitates a discussion where students share their thinking and teacher guides students toward the learning goals",[$]:"In the second part of this workshop you will choose a specific math simulation to plan a lesson around, identify the learning goals for your lesson, start developing plans for your lesson, and participate in a challenge prompt writing exercise.",[z]:"Watch an overview of our recommended strategies for writing a sim-based lesson. This presentation includes research-based activity-writing strategies, teacher insights, and real classroom footage.",[V]:"You have a busy year with a lot to cover. How is this lesson going to fit in? Will you replace a lesson? Will it be supplemental?",[Q]:"Think about where in the topic sequence it will fit. Will it introduce a topic? Reinforce a topic? Address common student misunderstandings?",[J]:"Writing Challenge Prompts",[Z]:"Writing an open-ended challenge prompt can be really challenging! The goal is to keep the prompts open enough that you aren’t instructing students on how to use the sim, but specific enough that students are achieving your learning goals.",[X]:"Review the learning goal and the original prompt. Consider how students will end up using the sim.",[ee]:"Listen to what some teachers came up with.",[et]:"Example: Proportion Playground",[en]:"Identify the greatest common factor of two numbers by observing the number of times a pattern repeats.",[ei]:"Create a bead pattern with 6 red and 8 blue. How many times does the pattern repeat? How is the number of repeats related to the total number of red beads and blue beads?",[eo]:"In this example, all students will be “answer-makers” because they are following the directions and finding an answer. If every student is doing the same thing with the sim, it is not taking full advantage of the exploratory nature of simulations. If every student is trying to find the same answers, it becomes harder to have a rich discussion.",[er]:"Create a bead pattern that repeats 3 times. Compare with a partner. How is the number of repeats related to the total number of red beads and blue beads? Challenge yourself to come up with a third pattern that also repeats 3 times.",[ea]:"In this version of the prompt, students are guided to find structure in their necklaces, and notice patterns in the numbers that produce the same bead pattern. All students get to the same learning goal as above, but by comparing results, students can easily see many iterations and use their own language to generalize their observations.",[es]:"1. Build an Atom",[el]:"Describe the sum of additive inverses.",[ec]:"Build an atom with 3 protons and 3 electrons. What is the net charge?",[eu]:"In order to respond to the prompt, how will students use the sim?",[em]:"Here is what teachers said:",[ed]:"2. Area Model Multiplication",[ep]:"Explain the relationship between the partial areas and the total area of a partitioned area model.",[eh]:"Make a model that is 13x17 and drag the lines to make 10+3 and 10+7. What are the four smaller areas, and how do they relate to the total area?",[eg]:"3. Graphing Lines",[ey]:"Identify parts of linear equations in Slope-Intercept.",[ef]:"Graph a line with slope=-⅔ and y-int=2. Compare your answer with the sim and write the equation.",[eb]:"4. Function Builder",[ev]:"Describe how symmetry impacts a rotation function.",[eS]:"Using the Wheel icon, introduce the Butterfly and the Snowflake. How do they transform after they go through the function?",[eP]:"5. Unit Rates",[ek]:"Look for patterns in the double number line.",[eE]:"Put a bag of apples in the scale. Remove an apple one at a time. What do you notice about the numbers in the double number line?",[ti]:"Is this your first time learning about PhET? If so, we encourage you to first finish the <a {{link1}}>Introduction to PhET Simulations</a> workshop and the <a {{link2}}>Whole-Class Strategies</a> workshop to learn how a PhET sim can be presented in a whole class setup.",[eT]:"<a {{link}}>Science Activity Design:</a> Create your own PhET inquiry-based activities for science classes.",[e7]:"<a {{link}}>Math Activity Design:</a> Create your own PhET inquiry-based activities for mathematics classes.",[ty]:"<a {{link}}>Facilitating PhET Simulation Use:</a> Prepare, implement, and reflect on your use of a PhET inquiry-based activity.",[to]:"Physics: Light and Filters — Pre-Lab Activity*",[tr]:"Physics: Light and Filters Activity Sheet",[ta]:"Physics: Light and Filters Teacher Guide",[ts]:"Biology: Natural Selection — Pre-Lab Activity",[tl]:"Biology: Natural Selection Activity Sheet",[tc]:"Biology: Natural Selection Teacher Guide",[tu]:"Chemistry: Measuring pH — Pre-Lab Activity",[tm]:"Chemistry: Measuring pH Activity Sheet",[td]:"Chemistry: Measuring pH Teacher Guide",[ew]:"Lesson Plan Template",[tp]:"Take a moment to summarize:",[th]:"How will you take what you have learned and implement it in the near future?",[tg]:"What are the main ideas or skills you learned from this workshop?"}},"types.jsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v,S,P;function k(e){for(var t=1;t<arguments.length;t++){var n=null!=arguments[t]?arguments[t]:{},i=Object.keys(n);"function"==typeof Object.getOwnPropertySymbols&&(i=i.concat(Object.getOwnPropertySymbols(n).filter(function(e){return Object.getOwnPropertyDescriptor(n,e).enumerable}))),i.forEach(function(t){var i;i=n[t],t in e?Object.defineProperty(e,t,{value:i,enumerable:!0,configurable:!0,writable:!0}):e[t]=i})}return e}n.export({text:()=>E,richText:()=>T,quote:()=>I,subHeader:()=>L,list:()=>x,iconText:()=>D,iconList:()=>R,table:()=>_,link:()=>K,video:()=>H,sim:()=>G,googleForm:()=>$,extraSpace:()=>V,goalPrompt:()=>J,newPrompt:()=>X,subjectLinkGroup:()=>et},!0),n.link("prop-types",{default(e){i=e}},0),n.link("react",{default(e){o=e},useRef(e){r=e}},1),n.link("react-google-recaptcha",{default(e){a=e}},2),n.link("../../../../../../api/data/constants.ts",{IMG_ROOT(e){s=e},STATIC_MOUNT_PATH(e){l=e}},3),n.link("website-common/geo",{ENGLISH_LOCALE(e){c=e}},4),n.link("../../../../../../api/strings/strings",{Strings(e){u=e}},5),n.link("../../../../../common.ts",{assert(e){m=e}},6),n.link("../../../../../components/subjectLink/SubjectLink.tsx",{SubjectLink(e){d=e}},7),n.link("../../../LocaleContext.ts",{useLocale(e){p=e}},8),n.li