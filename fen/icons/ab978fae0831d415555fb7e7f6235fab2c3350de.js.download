ve-description-ios"];if(e.type===b[g])return q.simulations.tooltip.accessibility["sound-and-sonification"];if(e.type===b[c])return q.simulations.tooltip.accessibility["alternative-input"];else if(e.type===b[f])return q.simulations.tooltip.accessibility["zoom-and-magnification"];else if(e.type===b[y])return q.simulations.tooltip.accessibility.voicing;else if(e.type===b[h])return q.simulations.tooltip.accessibility["interactive-highlights"];else if(e.type===b[u])return q.simulations.tooltip.accessibility["camera-input"];else if(e.type===b[m])return q.simulations.tooltip.accessibility["custom-gesture"];else return""})()}})))),o.createElement("div",{className:`badge-holder ${"checkbox-tooltip"!==e.tooltipClass&&e.type===P?P:""} ${e.className||""}`,onMouseOver:()=>{$(!0)},onMouseLeave:()=>{$(!1)}},J,e.includeTooltip?Z:"")}},"badgeStrings.json":function(e,t,n){n.exports={"simulations.tooltip.accessibility.alternative-input":"Alternative Input enables learners to use many different input methods like keyboards, switches, and joysticks.","simulations.tooltip.accessibility.interactive-description":"Accessed using screen reader software, Interactive Description provides an interactive described experience that dynamically updates and responds to learners actions.","simulations.tooltip.accessibility.interactive-description-ios":"Accessed using mobile VoiceOver on iPhones and iPads, this feature provides an interactive described experience that dynamically updates and responds to a learner's swipes and taps.","simulations.tooltip.accessibility.sound-and-sonification":"Sound and Sonifications are non-speech sounds that create an immersive and meaningful soundscape for learners. All sounds are optional.","simulations.tooltip.accessibility.voicing":"Enable Voicing in the Audio tab of the Preferences menu and choose the information you want to hear spoken aloud as you navigate and interact.","simulations.tooltip.accessibility.zoom-and-magnification":"Pan and Zoom allows anyone to zoom in for a closer look. On touch devices, pinch-to-zoom or drag to pan. Using a keyboard, zoom in and out with standard keyboard shortcuts and use arrow keys to pan. The sim auto pans to the focused object.","simulations.tooltip.accessibility.interactive-highlights":"Bright pink Interactive Highlights, like the ones for Alternative Input, can be enabled for mouse and touch in the Visual tab of Preferences menu.","simulations.tooltip.accessibility.camera-input":"Use your camera to recognize hand movements or colored objects placed within camera view to interact with the simulation objects and make changes.","simulations.tooltip.accessibility.custom-gesture":"Enable custom gesture on touch devices to use focus-based swipes and double taps instead of regular pointer-based taps and drags that often without obscure the screen.","simulations.tooltip.cheerpj":"CheerpJ allows Java sims to run in a browser.","simulations.tooltip.flash":"Flash sims run in flash-enabled browsers and will only be available <a {{0}}>through 2020</a>.","simulations.tooltip.html":"HTML5 sims run in modern web browsers on any device.","simulations.tooltip.htmlPrototype":"Prototypes are still in their design phase, subject to changes, and are not fully tested.","simulations.tooltip.community":"Community contributions are redesigned legacy PhET sims developed externally and are not fully tested.","simulations.tooltip.java":"Java sims can run on most Mac/Windows computers with the latest version of <a {{0}}>Java</a> installed."}}},banner:{"Banner.tsx":function(e,t,n){let i,o,r,a;n.export({Banner:()=>s,BannerModel:()=>l},!0),n.link("react",{default(e){i=e}},0),n.link("../../../api/data/constants",{IMG_ROOT(e){o=e}},1),n.link("../../common",{assert(e){r=e}},2),n.link("../../commonStyles",{studioGradientLight(e){a=e}},3);let s=e=>{null==r||r(!(e.model.image&&e.model.allowWideText),"Banner with image should not have wide text");let t=`
  #phet-top-level-banner .banner-container::before {
    background-image: url("${o}/banners/${e.model.image}");
  }
  `,n=`
  #phet-top-level-banner.container {
    background: ${e.model.color};
  }
  
  #phet-top-level-banner .banner-header-container .h1 {
