p.landingPage.facilitatingPhetSimulationUse.description,time:n(6),color:c.pink,icon:"teacher.svg",href:u(e)})))}),{getLink:d}),T=e=>i.createElement("a",{className:`virtual-workshop-link ${e.className||""}`,href:e.href,style:{borderColor:`${e.color.stroke}`,background:`${e.color.fillLight}`}},i.createElement("div",{className:"sidebar",style:{background:`${e.color.stroke}`}}),i.createElement("img",{src:`${o}/${e.icon}`,className:"icon"}),i.createElement("h2",{className:"h3 title"},e.title),i.createElement("p",{className:"p description"},e.description),i.createElement("div",{className:"time"},i.createElement("img",{src:`${o}/time-white-icon.svg`,className:"time-icon"}),i.createElement("p",{className:"p"},e.time)))},"virtualWorkshopLandingPageStrings.json":function(e,t,n){n.exports={"virtualWorkshop.landingPage.title":"Virtual Workshops","virtualWorkshop.landingPage.introduction1.v2":'Work through these workshops to learn about PhET’s suggested pedagogical strategies. Alternatively, take our Coursera specialization <a {{href}}>"Active Learning in STEM with PhET Interactive Simulations"</a> and receive a certificate for a fee.',"virtualWorkshop.landingPage.introduction2":"Math teachers with devices for every student may take the condensed <a {{0}}>Teaching Math with PhET</a> workshop. ","virtualWorkshop.hours":"hours","virtualWorkshop.introductionToPhet.introductionToPhet":"Introduction to PhET","virtualWorkshop.landingPage.introductionToPhet.description":"Learn how to access and share PhET simulations with your students and explore the features that make PhET sims a powerful tool for science and mathematics teachers.","virtualWorkshop.wholeClassStrategies.wholeClassStrategies":"Whole-Class Strategies","virtualWorkshop.landingPage.wholeClassStrategies.description":"Learn strategies for how to use PhET in circumstances where you are presenting a simulation in front of the whole class using a projector, interactive whiteboard, or sharing your screen online.","virtualWorkshop.mathActivityDesign.mathActivityDesign":"Math Activity Design","virtualWorkshop.landingPage.mathActivityDesign.description":"Learn strategies to create sim-based inquiry activity sheets for math classes where students have direct access to simulations on a singular or shared device.","virtualWorkshop.scienceActivityDesign.scienceActivityDesign":"Science Activity Design","virtualWorkshop.landingPage.scienceActivityDesign.description":"Learn strategies to create sim-based inquiry activity sheets for science classes where students have direct access to simulations on a singular or shared device.","virtualWorkshop.facilitatingPhetUse.facilitatingPhEtSimulationUse":"Facilitating PhET Simulation Use","virtualWorkshop.landingPage.facilitatingPhetSimulationUse.description":"Learn how to effectively design a learning sequence that makes use of PhET’s simulations for mathematics and science."}}},"introduction-to-phet":{"IntroToPhetWorkshop.jsx":function(e,t,n){var i,o,r;let a,s,l,c,u,m;n.export({IntroToPhetWorkshop:()=>d}),n.link("prop-types",{default(e){a=e}},0),n.link("react",{default(e){s=e}},1),n.link("../common/constants.ts",{INTRO_TO_PHET(e){l=e}},2),n.link("../common/VirtualWorkshop.jsx",{VirtualWorkshop(e){c=e}},3),n.link("./introToPhetData.jsx",{INTO_TO_PHET_DATA(e){u=e}},4),n.link("./introToPhetStrings.ts",{INTRO_TO_PHET_FALLBACK_STRINGS(e){m=e}},5);class d extends(i=s.Component){render(){return s.createElement(c,{section:this.props.section,workshopType:l,title:u.title,sections:u.sections,strings:m})}constructor(e){super(e)}}o="propTypes",r={section:a.string},o in d?Object.defineProperty(d,o,{value:r,enumerable:!0,configurable:!0,writable:!0}):d[o]=r},"introToPhetData.jsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v,S,P,k,E,w,T,O,I,C,L,j,x,A,N,D,M,R,F,_,B,W,K,U,H,q,G,Y,$,z,V,Q,J,Z,X,ee,et,en,ei,eo,er,ea,es,el,ec,eu,em,ed,ep,eh,eg,ey,ef,eb,ev,eS,eP,ek,eE,ew,eT,eO,eI,eC,eL,ej,ex,eA,eN,eD,eM,eR,eF,e_,eB,eW,eK,eU,eH,eq,eG,eY,e$,ez,eV,eQ,eJ,eZ,eX,e1,e0,e2,e3,