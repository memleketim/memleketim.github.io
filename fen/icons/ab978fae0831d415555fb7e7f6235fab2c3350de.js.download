se.about.join.header":"Join the {brandTitle} Community","sceneryStackOse.about.join.description":"If you are interested in creating accessible interactives, games, or simulations, we encourage you to <a {hrefLearn}>learn about {brandTitle}</a> and <a {hrefJoin}>join the discussion</a>."}}},funders:{"SceneryStackOseFundersPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d;function p(e){for(var t=1;t<arguments.length;t++){var n=null!=arguments[t]?arguments[t]:{},i=Object.keys(n);"function"==typeof Object.getOwnPropertySymbols&&(i=i.concat(Object.getOwnPropertySymbols(n).filter(function(e){return Object.getOwnPropertyDescriptor(n,e).enumerable}))),i.forEach(function(t){var i;i=n[t],t in e?Object.defineProperty(e,t,{value:i,enumerable:!0,configurable:!0,writable:!0}):e[t]=i})}return e}n.export({nationalScienceFoundationUntranslateable:()=>h,SceneryStackOseFundersPanel:()=>g},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../../api/strings/useStrings",{useStrings(e){o=e}},1),n.link("../../../../components/phetText/PhetText",{H2(e){r=e},H3(e){a=e},P(e){s=e}},2),n.link("../SceneryStackOseRoutes",{SceneryStackOseRoutes(e){l=e}},3),n.link("../../../../../api/strings/strings",{Strings(e){c=e}},4),n.link("./sceneryStackOseFundersPanelStrings.json",{default(e){u=e}},5),n.link("../../../../../api/urlUtils",{externalInlineHrefProps(e){m=e}},6),n.link("../../../../../api/data/constants",{IMG_ROOT(e){d=e}},7);let h="National Science Foundation",g={panel:()=>{let e=o(u);return i.createElement("div",{className:"initiatives-panel section"},i.createElement("section",{className:"minor-section"},i.createElement(r,{className:"col2"},h),i.createElement(s,null,c.fillIn(e.sceneryStackOse.funders.nsfDescription,{brandTitle:l.brandTitle,nationalScienceFoundation:h}))),i.createElement("section",{className:"minor-section two-column-with-image-section"},i.createElement("img",{className:"col1 two-column-icon",src:`${d}/scenerystack-ose/nsf-icon.png`,alt:""}),i.createElement(s,{className: