eR,reflectOnTheLessonAfterStringKey:()=>eF,whenYouGetABitStringKey:()=>e_,reflectionToolPostImplementationLongStringKey:()=>eB,reflectionToolPostImplementationShortStringKey:()=>eW,ifYouHadAnObserverStringKey:()=>eK,whatPatternsBothInTermsStringKey:()=>eU,TeacherAndStudentPrevalentBehaviorsStringKey:()=>eH,whatTeacherAndStudentAbsentBehaviorsStringKey:()=>eq,didTheObserversNotesReflectStringKey:()=>eG,asAResultOfTheStringKey:()=>eY,useThePostImplementationReflectionStringKey:()=>e$,congratulationsYouHaveCompletedTheStringKey:()=>ez,afterYouHaveMadeYourStringKey:()=>eV,youHaveCompletedTheFinalStringKey:()=>eQ,workshopStringKey:()=>eJ,writeYourPlanStringKey:()=>eZ,nowItIsTimeToStringKey:()=>eX,physicsLightFiltersStringKey:()=>e1,biologyNaturalSelectionStringKey:()=>e0,chemistryMeasuringPhStringKey:()=>e2,mathematicsDefiningFunctionsActivitySheetStringKey:()=>e3,mathematicsDefiningFunctionsTeacherGuideStringKey:()=>e5,reflectOnYourPlanStringKey:()=>e4,reflectOnYourLessonPlanStringKey:()=>e7,howDoIUsePhEtStringKey:()=>e6,letUsKnowHowThingsStringKey:()=>e9,FACILITATING_PHET_SIM_USE_FALLBACK_STRINGS:()=>e8},!0);let i="virtualWorkshop.facilitatingPhetUse.facilitatingPhEtSimulationUse",o="virtualWorkshop.facilitatingPhetUse.inThisVirtualWorkshopYou",r="virtualWorkshop.facilitatingPhetUse.isThisYourFirstTime",a="virtualWorkshop.facilitatingPhetUse.becomeFamiliarWithStrategiesTo",s="virtualWorkshop.facilitatingPhetUse.implementASimBasedMathematics",l="virtualWorkshop.facilitatingPhetUse.reflectOnAndReviseA",c="virtualWorkshop.facilitatingPhetUse.thisWorkshopAsksYouTo",u="virtualWorkshop.facilitatingPhetUse.aLessonPlanIsA",m="virtualWorkshop.facilitatingPhetUse.sixHours",d="virtualWorkshop.facilitatingPhetUse.ifYouAlreadyTookThe",p="virtualWorkshop.facilitatingPhetUse.phEtRecommendsThatLessonPlans",h="virtualWorkshop.facilitatingPhetUse.overviewThisSectionIncludesStudents",g="virtualWorkshop.facilitatingPhetUse.preLabAPreLab",y="virtualWorkshop.facilitatingPhetUse.openPlayTime