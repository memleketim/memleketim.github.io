/a>.","phetGlobal.resources.pedagogy.heading":"Pedagogy","phetGlobal.resources.pedagogy.description.v2":"Learn how to incorporate simulations using effective teaching strategies found in our professional development <a {{developmentHref}}>events</a>, including our virtual workshops on our <a {{workshopHref}}>website</a> and hosted on <a {{courseraHref}}>Coursera</a>.","phetGlobal.resources.dissemination.heading":"Dissemination","phetGlobal.resources.dissemination.description":"(Coming soon) Find social media, presentation, and workshop resources to help others learn how to incorporate PhET sims in their classrooms.","phetGlobal.resources.help.heading":"Having trouble? Visit the Help Center.","phetGlobal.resources.help.description":"The <a {{href}}>help center</a> includes guidelines for getting started, how to run and integrate sims, and troubleshooting tips."}}},stories:{"PhetGlobalStoriesPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f;n.export({PhetGlobalStoriesPanel:()=>b},!0),n.link("meteor/meteor",{Meteor(e){i=e}},0),n.link("react",{default(e){o=e},useEffect(e){r=e},useState(e){a=e}},1),n.link("../../../../../api/data/constants",{OPTIONAL_METEOR_PREFIX(e){s=e}},2),n.link("../../../../../api/phetGlobalStories/phetGlobalStories.js",{PhetGlobalStories(e){l=e}},3),n.link("../../../../../api/strings/useStrings",{useStrings(e){c=e}},4),n.link("../../../../components/phetCard/PhetCard",{PhetCard(e){u=e}},5),n.link("../../../../components/spinner/Spinner",{Spinner(e){m=e}},6),n.link("../../LocaleContext",{useLocale(e){d=e}},7),n.link("../PhetGlobalPanel",{PhetGlobalPanel(e){p=e}},8),n.link("./phetGlobalStoriesPanelStrings.json",{default(e){h=e}},9),n.link("../../../../components/richString/RichString",{RichString(e){g=e}},10),n.link("website-common/geo",{ENGLISH_LOCALE(e){y=e},SPANISH_LOCALE(e){f=e}},11);let b={panel:()=>{let e=c(h),t=d(),[n,b]=a(null);if(r(()=>{l.fetch(i.isDevelopment,e=>{b(e)})},[]),!n)return o.createElement(m,null);let v=n.filter(e=>t.s