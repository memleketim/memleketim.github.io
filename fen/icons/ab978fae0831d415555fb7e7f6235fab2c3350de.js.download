e teaching styles.","phetStudioOverview.about.bringToYourFavoritePlatform":"Bring to your Favorite Platform:","phetStudioOverview.about.hostedByPhet":"Presets are hosted by PhET and can be shared as a URL. If you can use a PhET sim in a tool, you can use a preset too!","phetStudioOverview.about.simsAreStillFree":"PhET Simulations are still free for teachers and students and always will be. PhET Studio is a paid service that allows users to preset and save sims in a custom configuration.","phetStudioOverview.about.fuelPhetSustainability":"Each purchase of a PhET Studio seat will fuel PhET’s sustainability for years to come!"}}},faq:{"PhetStudioOverviewFaqPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v,S,P,k,E;n.export({PhetStudioOverviewFaqPanel:()=>en},!0),n.link("react",{default(e){i=e}},0),n.link("website-common/common",{getMailtoHref(e){o=e},PhetContactEmail(e){r=e}},1),n.link("../../../../../../api/data/constants",{IMG_ROOT(e){a=e}},2),n.link("../../../../../../api/simulations/useProjects",{useProjects(e){s=e}},3),n.link("../../../../../../api/strings/useStrings",{useStrings(e){l=e}},4),n.link("../../../../../../api/urlUtils",{getInlineHref(e){c=e}},5),n.link("../../../../../components/disclosure/DisclosureList",{DisclosureList(e){u=e}},6),n.link("../../../../../components/links/FloatingLink",{FloatingLink(e){m=e}},7),n.link("../../../../../components/phetText/PhetText",{H2(e){d=e},H3(e){p=e},P(e){h=e}},8),n.link("../../../../../components/richString/RichString",{RichString(e){g=e}},9),n.link("../../../../../components/spinner/Spinner",{Spinner(e){y=e}},10),n.link("../../../../../StaticFilePath",{StaticFilePath(e){f=e}},11),n.link("../../../LocaleContext",{useLocale(e){b=e}},12),n.link("../../../my-phet/my-presets/MyPresetsPanelPath",{MyPresetsPanelPath(e){v=e}},13),n.link("../PhetStudioGirlCalloutPanel",{PhetStudioGirlCalloutPanel(e){S=e}},14),n.link("../PhetStudioTryItOutPanel",{PhetStudioTryItOutPanel(e){P=e}},15),n.link("./phetStudioOverview