ven initiatives and the establishment and application of an equity framework to PhET’s resources and professional development programs.","deib-in-stem-ed.commitment.donors":"Donors"}}},framework:{"DeibInStemEdFrameworkPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f;n.export({DeibInStemEdFrameworkPanel:()=>v},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../../api/data/constants",{IMG_ROOT(e){o=e},OPTIONAL_METEOR_PREFIX(e){r=e}},1),n.link("../../../../../api/strings/useStrings",{useStrings(e){a=e}},2),n.link("../../../../../api/urlUtils.js",{getInlineExternalHref(e){s=e},getInlineHref(e){l=e}},3),n.link("../../../../components/phetText/PhetText",{H2(e){c=e},H3(e){u=e},P(e){m=e},Span(e){d=e}},4),n.link("../../../../components/richString/RichString",{RichString(e){p=e}},5),n.link("../../LocaleContext",{useLocale(e){h=e}},6),n.link("./deibInStemEdFrameworkPanelStrings.json",{default(e){g=e}},7),n.link("../commitment/DeibInStemEdCommitmentPanel",{DeibInStemEdCommitmentPanel(e){y=e}},8),n.link("../DeibInStemEdRoutes",{DeibInStemEdRoutes(e){f=e}},9);let b="framework",v={panel:()=>{let e=a(g),t=h();return i.createElement("div",{className:"initiatives-panel strategy-panel"},i.createElement("section",{className:"section"},i.createElement(c,null,e["deib-in-stem-ed"].strategy.header),i.createElement(m,null,i.createElement(p,{string:e["deib-in-stem-ed"].strategy.description.v2,interpolatedValues:{href:s("https://www.chalkbeat.org/pages/chalkbeat-diversity-equity-inclusion-belonging")}})),i.createElement("ul",{className:"ul"},i.createElement("li",{className:"li p"},i.createElement(d,{className:"bold"}," ",e["deib-in-stem-ed"].strategy.diversity),":\xa0",i.createElement(d,null," ",e["deib-in-stem-ed"].strategy.diversityDescription)),i.createElement("li",{className:"li p"},i.createElement(d,{className:"bold"}," ",e["deib-in-stem-ed"].strategy.equity),":\xa0",i.createElement(d,null," ",e["deib-in-stem-ed"].strategy.equityDescription)),i.createElement("li",{cl