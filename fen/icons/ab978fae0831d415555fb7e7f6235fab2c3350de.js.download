)=>j,whatSkillsAndAttitudesAreStringKey:()=>x,whatShouldBeYourRoleStringKey:()=>A,thereAreManyWaysToStringKey:()=>N,howMightThisFlowWorkStringKey:()=>D,whatClassroomNormsMightYouStringKey:()=>M,whatDoesAPhEtActivityStringKey:()=>R,funkyFunctionsActivitySheetStringKey:()=>F,variableExpressionsActivitySheetStringKey:()=>_,whatDoYouNoticeAboutStringKey:()=>B,doYouHaveAnyCritiquesStringKey:()=>W,whatDoYouLikeOrStringKey:()=>K,readingIconASummaryOfStringKey:()=>U,activitySheetDesignStringKey:()=>H,theSimCenteredLearningExperienceStringKey:()=>q,letsPracticeWritingSomeChallengeStringKey:()=>G,useTheDocumentBelowToStringKey:()=>Y,challengePromptExerciseStringKey:()=>$,forEachSimActivityStringKey:()=>z,rememberThereIsNotAStringKey:()=>V,synthesizingKnowledgeStringKey:()=>Q,aConcludingActivityIsImportantStringKey:()=>J,verifyingStudentsAchievementOfLearningStringKey:()=>Z,includingFinalQuestionsOnTheStringKey:()=>X,usingConceptQuestionsAndFacilitatingStringKey:()=>ee,preparingACoupleOfWrittenStringKey:()=>et,watchTheFollowingVideoWhichStringKey:()=>en,asYouBringEverythingTogetherStringKey:()=>ei,congratulationsCompletedMathStringKey:()=>eo,congratulationsYourTurnTheStringKey:()=>er,ifYouAreTakingThisStringKey:()=>ea,activitySheetTemplateStringKey:()=>es,nowThatYouKnowHowStringKey:()=>el,activitySheetGuidelinesStringKey:()=>ec,threeToFiveHoursStringKey:()=>eu,MATH_ACTIVITY_DESIGN_FALLBACK_STRINGS:()=>em},!0);let i="virtualWorkshop.mathActivityDesign.mathActivityDesign",o="virtualWorkshop.mathActivityDesign.inThisVirtualWorkshopWe",r="virtualWorkshop.mathActivityDesign.reflectOnInquiryLearningIn",a="virtualWorkshop.mathActivityDesign.developStrategiesForWritingSim",s="virtualWorkshop.mathActivityDesign.designASimBasedMath",l="virtualWorkshop.mathActivityDesign.inTheFirstPartOf",c="virtualWorkshop.mathActivityDesign.whatFeaturesDoTheSims",u="virtualWorkshop.mathActivityDesign.whatThingsCanYouDo",m="virtualWorkshop.mathActivityDesign.howCouldYouUseSims",d="virtualWorkshop.mathActivityDesign.belowListenToSome",p="virtualWorkshop.mathActivityDesign.howWasYourExperienceSimilar",h="virtualWorkshop.mathActivityDesign.doYouAgreeWithTeachers",g="virtualWorkshop.mathActivityDesign.thinkAboutHowYouMight",y="virtualWorkshop.mathActivityDesign.studentsInteractingWithSims",f="virtualWorkshop.mathActivityDesign.studentsCanInteractWithSimulations",b="virtualWorkshop.mathActivityDesign.researchShowsThatStudentsWill",v="virtualWorkshop.mathActivityDesign.guidedInquiryActivitiesUsingWorksheets",S="virtualWorkshop.mathActivityDesign.homeworkAssignmentsAssignHomeworkQuestions",P="virtualWorkshop.mathActivityDesign.combinedPhysicalAndDigitalManipulative",k="virtualWorkshop.mathActivityDesign.guidedInquiryActivitiesInRemote",E="virtualWorkshop.mathActivityDesign.notePhEtStronglyRecommendsThat",w="virtualWorkshop.mathActivityDesign.nextYoullBeWorkingOn",T="virtualWorkshop.mathActivityDesign.afterwardReviewTheLesson",O="virtualWorkshop.mathActivityDesign.atomicAdditionLesson",I="virtualWorkshop.mathActivityDesign.nowThatYouveCompletedThe",C="virtualWorkshop.mathActivityDesign.didYouAchieveTheLessons",L="virtualWorkshop.mathActivityDesign.reflectOnTheFlowOf",j="virtualWorkshop.mathActivityDesign.whatCharacteristicsAndStructureDo",x="virtualWorkshop.mathActivityDesign.whatSkillsAndAttitudesAre",A="virtualWorkshop.mathActivityDesign.whatShouldBeYourRole",N="virtualWorkshop.mathActivityDesign.thereAreManyWaysTo",D="virtualWorkshop.mathActivityDesign.howMightThisFlowWork",M="virtualWorkshop.mathActivityDesign.whatClassroomNormsMightYou",R="virtualWorkshop.mathActivityDesign.whatDoesAPhEtActivity",F="virtualWorkshop.mathActivityDesign.funkyFunctionsActivitySheet",_="virtualWorkshop.mathActivityDesign.variableExpressionsActivitySheet",B="virtualWorkshop.mathActivityDesign.whatDoYouNoticeAbout",W="virtualWorkshop.mathActivityDesign.doYouHaveAnyCritiques",K="virtualWorkshop.mathActivityDesign.whatDoYouLikeOr",U="virtualWorkshop.mathActivityDesign.readingIconASummaryOf",H="virtualWorkshop.mathActivityDesign.activitySheetDesign",q="virtualWorkshop.mathActivityDesign.theSimCenteredLearningExperience",G="virtualWorkshop.mathActivityDesign.letsPracticeWritingSomeChallenge",Y="virtualWorkshop.mathActivityDesign.useTheDocumentBelowTo",$="virtualWorkshop.mathActivityDesign.challengePromptExercise",z="virtualWorkshop.mathActivityDesign.forEachSimActivity",V="virtualWorkshop.mathActivityDesign.rememberThereIsNotA",Q="virtualWorkshop.mathActivityDesign.synthesizingKnowledge",J="virtualWorkshop.mathActivityDesign.aConcludingActivityIsImportant",Z="virtualWorkshop.mathActivityDesign.verifyingStudentsAchievementOfLearning",X="virtualWorkshop.mathActivityDesign.includingFinalQuestionsOnThe",ee="virtualWorkshop.mathActivityDesign.usingConceptQuestionsAndFacilitating",et="virtualWorkshop.mathActivityDesign.preparingACoupleOfWritten",en="virtualWorkshop.mathActivityDesign.watchTheFollowingVideoWhich",ei="virtualWorkshop.mathActivityDesign.asYouBringEverythingTogether",eo="virtualWorkshop.mathActivityDesign.congratulationsCompletedMath",er="virtualWorkshop.mathActivityDesign.congratulationsYouHaveCompletedThe",ea="virtualWorkshop.mathActivityDesign.ifYouAreTakingThis",es="virtualWorkshop.mathActivityDesign.activitySheetTemplate",el="virtualWorkshop.mathActivityDesign.nowThatYouKnowHow",ec="virtualWorkshop.mathActivityDesign.activitySheetGuidelines",eu="virtualWorkshop.threeToFiveHours",em={[i]:"Math Activity Design",[o]:"In this virtual workshop, we will review strategies for how to use PhET to create sim-based inquiry activities for math classes, including activity sheets that students can use as they work independently or in small groups while they have direct access to simulations on their own device.",[r]:"Reflect on inquiry learning in math education.",[a]:"Develop strategies for writing sim-based inquiry activities for math.",[s]:"Design a sim-based math lesson plan and activity sheet.",[l]:"In the first part of this workshop, you will discover and reflect on the learning benefits of playing with simulations through open play and reflection time. By the end of this section, you will have a strong understanding of how to leverage the design and scaffolding of a simulation to best support student inquiry and conceptual understanding.",[c]:"What features do the sims have?",[u]:"What things can you do with sims?",[m]:"How could you use sims with your students?",[d]:"Below, listen to some responses from math teachers about their experience playing with math sims for the first time.",[p]:"How was your experience similar to that of the teachers highlighted in these videos?",[h]:"Do you agree with teachers’ comments on how and why they plan to use the sims?",[g]:"Think about how you might introduce a new sim to your students. How would you begin?",[y]:"Students Interacting with Sims",[f]:"Students can interact with simulations (sims) at the beginning of an instructional unit to explore which variables influence the mathematical system, and relate what they learn to their prior knowledge. Such interaction supports the construction of mathematical models. Students can also use a sim at the end of a unit to reinforce what they have learned and apply this knowledge to solve problems.",[b]:"<a {{link}}>Research</a> shows that students will benefit the most from sims when you give them a high degree of autonomy over their learning, and when you encourage them to explore questions with the sims individually or in small groups. Structured interaction with sims is especially valuable when you have learning goals in mind that target skills and procedures. For example, you can design scenarios that allow students to control system variables. Students can use PhET sims in the following setups:",[v]:"<span {{class}}>Guided-inquiry activities using worksheets during class:</span> Design short activity worksheets focused on sims for student groups to work through in class. You can check in with the whole class and facilitate class discussions periodically during the activity to ensure that students are all mastering key ideas before moving on.",[S]:"<span {{class}}>Homework assignments:</span> Assign homework questions that require the use of a sim as part of pre-class preparation before a topic is covered in class, or as a follow-up in which students dig deeper into a topic you may have demonstrated that day. The design of PhET sims allows students to engage in mathematical thinking, even without the presence of an instructor to guide them.",[P]:"<span {{class}}>Combined physical and digital manipulative activities:</span> PhET sims can complement typical physical manipulative activities (e.g., working with coins, geometric objects, etc.) to help students expand their repertoire of representations and transfer knowledge across different domains within mathematics.",[k]:"<span {{class}}>Guided-inquiry activities in remote learning:</span> Comprehensive mathematics education requires that students engage with mathematical thinking in different contexts, and PhET resources are among your best allies, particularly for remote learning. You can use digital worksheets to engage students in an inquiry activity, and you can easily integrate PhET sims with learning management systems and other tech tools to make the experience more personalized and collaborative while providing quick feedback on students’ understanding.",[E]:"Note: PhET strongly recommends that teachers avoid using “cook-book” style activities, in which teachers provide lists of detailed, explicit instructions on how to modify the sim, and what to observe, as it can limit student exploration and engagement.",[w]:"Next, you’ll be working on #2-12 of the activity below as a student.",[T]:"Afterward, review the  lesson plan below to get an idea about how this activity can be implemented in a classroom.",[O]:"Atomic Addition Lesson",[I]:"Now that you’ve completed the activity as a student,",[C]:"Did you achieve the lesson’s learning goals, and how do you know?",[L]:"Reflect on the flow of the lesson you just experienced and how it was structured:",[j]:"What characteristics and structure do the activities have?",[x]:"What skills and attitudes are also fostered by these types of activities?",[A]:"What should be your role and that of your students in such an activity?",[N]:"There are many ways to teach using a PhET sim, but the  lesson presented in the previous section follows a simple structure that is easy to replicate:",[D]:"How might this flow work in your classroom?",[M]:"What classroom norms might you need to establish?",[R]:"What does a PhET activity worksheet look like? Start by reviewing the following activity sheets.",[F]:"Funky Functions Activity Sheet",[_]:"Variable Expressions Activity Sheet",[B]:"What do you notice about the activity sheet questions?",[W]:"Do you have any critiques?",[K]:"What do you like, or not like?",[U]:"A summary of the information contained in the video can be found in the following document:",[H]:"Activity Sheet Design",[q]:"The sim-centered learning experience should be planned and organized in a worksheet in a way that encourages inquiry. The worksheet should allow students to explore, gather and analyze data, and draw conclusions on the basis of reasoning and analysis, and achieving this can be done with the use of open-ended Challenge Prompts.",[G]:"Let’s practice writing some Challenge Prompts.",[Y]:"Use the document below to support you as you try writing Challenge Prompts throughout the following activity. (Avoid looking at the PhET team’s recommended revised prompts until you have tried the activity on your own!)",[$]:"Challenge Prompt Exercise",[z]:"For each sim activity:",[V]:"Remember, there is not a “correct” Challenge Prompt or a “best” activity worksheet. Prompts and worksheets might work differently for each classroom. The modified Challenge Prompts here  are only examples that can guide you to take advantage of the characteristics of PhET sims and the activity design tips mentioned in this workshop. However, writing good activities is a process that involves regular adaptation and depends on the nature of your students.",[Q]:"Synthesizing Knowledge",[J]:"A concluding activity is important for determining if students have achieved the learning goals. Students should be able to communicate their answers and justify conclusions with evidence they have collected during the activity. Additionally, students should be able to answer questions about scenarios other than the exact one used in their activity, thereby demonstrating their ability to apply their understanding to new contexts.",[Z]:"Verifying students’ achievement of learning goals can be accomplished in several ways, such as the following:",[X]:"Including final questions on the activity sheet that help students synthesize conclusions.",[ee]:"Using Concept Questions and facilitating a final oral discussion with the group.",[et]:"Preparing a couple of written questions as an “exit ticket” for students to submit.",[en]:"Watch the following video, which illustrates how to synthesize knowledge and move from the digital mathematical representations to pencil and paper activities.",[ei]:"As you bring everything together, don’t forget to allow time for “teachable moments”, to highly unexpected student discoveries, and to incorporate their learnings into the bigger picture. See one example below of how a skilled teacher does this.",[eo]:"Congratulations! You have completed the Math Activity Design workshop.",[er]:"Now it’s time to design a draft of your first PhET activity. Review the instructions for the activity in the document below.",[ea]:"If you are taking this course independently, we recommend that you complete the following activities and save them to your computer. (Should you later decide to enroll in a facilitated version of this course, you can then submit these assignments to earn a certificate).",[es]:"Activity Sheet Template",[el]:"Now that you know how to design a math activity using PhET, continue with your learning journey with one of our other workshops: ",[ec]:"Activity Sheet Guidelines",[eu]:"3-5 hours"}}},"science-activity-design":{"ScienceActivityDesignWorkshop.jsx":function(e,t,n){var i,o,r;let a,s,l,c,u,m;n.export({ScienceActivityDesignWorkshop:()=>d}),n.link("prop-types",{default(e){a=e}},0),n.link("react",{default(e){s=e}},1),n.link("../common/constants.ts",{SCIENCE_ACTIVITY_DESIGN(e){l=e}},2),n.link("../common/VirtualWorkshop.jsx",{VirtualWorkshop(e){c=e}},3),n.link("./scienceActivityDesignData.jsx",{SCIENCE_ACTIVITY_DESIGN_DATA(e){u=e}},4),n.link("./scienceActivityDesignStrings.ts",{SCIENCE_ACTIVITY_DESIGN_FALLBACK_STRINGS(e){m=e}},5);class d extends(i=s.Component){render(){return s.createElement(c,{section:this.props.section,workshopType:l,title:u.title,sections:u.sections,strings:m})}constructor(e){super(e)}}o="propTypes",r={section:a.string},o in d?Object.defineProperty(d,o,{value:r,enumerable:!0,configurable:!0,writable:!0}):d[o]=r},"scienceActivityDesignData.jsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v,S,P,k,E,w,T,O,I,C,L,j,x,A,N,D,M,R,F,_,B,W,K,U,H,q,G,Y,$,z,V,Q,J,Z,X,ee,et,en,ei,eo,er,ea,es,el,ec,eu,em,ed,ep,eh,eg,ey,ef,eb,ev,eS,eP,ek,eE,ew,eT,eO,eI,eC,eL,ej,ex,eA,eN,eD,eM,eR,eF,e_,eB,eW,eK,eU,eH,eq,eG,eY,e$,ez,eV,eQ,eJ,eZ,eX,e1,e0,e2,e3,e5,e4,e7,e6,e9,e8,te,tt,tn,ti,to,tr,ta,ts,tl,tc,tu,tm,td,tp,th,tg,ty,tf,tb,tv,tS,tP,tk,tE,tw,tT,tO,tI,tC,tL,tj,tx,tA,tN,tD,tM,tR,tF,t_,tB,tW,tK,tU,tH,tq,tG,tY,t$,tz,tV,tQ,tJ,tZ,tX,t1,t0,t2,t3,t5,t4,t7,t6,t9,t8,ne,nt,nn,ni,no,nr,na,ns,nl,nc,nu,nm,nd,np,nh,ng,ny,nf,nb,nv,nS,nP,nk,nE,nw,nT,nO,nI,nC,nL,nj,nx,nA,nN,nD,nM,nR,nF,n_,nB,nW,nK,nU,nH,nq,nG,nY,n$,nz,nV,nQ,nJ,nZ,nX,n1,n0,n2,n3,n5,n4,n7,n6,n9,n8,ie,it,ii,io,ir,ia,is,il,ic,iu,im,id,ip,ih,ig,iy,ib,iv,iS,iP,ik,iE;n.export({SCIENCE_ACTIVITY_DESIGN_DATA:()=>iw},!0),n.link("website-common/geo",{ENGLISH_LOCALE(e){i=e},SPANISH_LOCALE(e){o=e}},0),n.link("../../../../../../api/data/constants.ts",