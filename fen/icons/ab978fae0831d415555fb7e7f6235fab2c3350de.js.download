the desktop app.","offline-access.individualSims.header":"Individual Sims","offline-access.desktop.individualSims.description":"Individual HTML5 and Java sims can be downloaded from the sim page by clicking the download button {{0}} under the simulation name. <a {{1}}>System Requirements</a>.","offline-access.android.individualSims.description":"Individual HTML5 sims can be downloaded from the sim page by clicking the download button {{0}} under the simulation name. <a {{1}}>System Requirements</a>.","offline-access.desktop.individualSims.flashWarning":"Flash simulations are no longer supported in modern browsers. Learn more in our <a {{0}}>Help Center</a>.","offline-access.android.header":"Android Phones, Tablets, and Chromebooks","offline-access.android.app.header":"Android App","offline-access.android.appDescription":"The PhET Android app contains all HTML5 simulations, including their translations, for offline use on Android phones, tablets, and <a {{0}}>select Chromebooks</a>. All proceeds support the development of new HTML5 simulations and the app automatically downloads new HTML5 simulations.","offline-access.android.licensesForSchools":"Learn more about <a {{0}}>licenses for schools</a>.","offline-access.ios.header":"iPhones and iPads","offline-access.ios.app.title":"iOS App","offline-access.ios.appDescription":"The PhET iOS app contains all HTML5 simulations, including their translations, for offline use on iPhones and iPads. All proceeds support the development of new HTML5 simulations and the app automatically downloads new HTML5 simulations.","offline-access.ios.readingList":"In order to run an HTML5 sim offline on an iPhone or iPad, add it to the <a {{0}}>reading list</a>."}}},"our-supporters":{"OurSupportersPage.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v,S,P,k,E,w,T;function O(e){for(var t=1;t<arguments.length;t++){var n=null!=arguments[t]?arguments[t]:{},i=Object.keys(n);"function"==typeof Object.getOwnPropertySymbols&&(i=i.concat(Obj