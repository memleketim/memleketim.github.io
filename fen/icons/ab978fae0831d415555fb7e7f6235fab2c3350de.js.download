"video",{controls:!0,muted:!0,playsInline:!0,className:"features-video","aria-label":t.phetStudioOverview.features.comingSoonNarrowAltText},i.createElement("source",{src:`${l}/phet-studio/coming-soon.webm`,type:"video/webm"}),i.createElement("source",{src:`${l}/phet-studio/coming-soon.mp4`,type:"video/mp4"})))),i.createElement("div",{className:"initiatives-panel section"},i.createElement(c,null)))},path:"features"}},"phetStudioOverviewFeaturesPanelStrings.json":function(e,t,n){n.exports={"phetStudioOverview.features.setSaveSend":"Set. Save. Send.","phetStudioOverview.features.setSaveSendVideoAltText":"Video showing a configuration of Greenhouse Effect within PhET Studio. The user clicks save, then share, then copy link.","phetStudioOverview.features.setUpAndSave":"With PhET Studio, you can set up and save presets ahead of time. No more long instruction pages, lost instructional time, or tiny screenshots. Simply set up the sim in your desired configuration, save it, and send your students a link.","phetStudioOverview.features.fixInAFlash":"Fix in a Flash","phetStudioOverview.features.fixInAFlashVideoAltText":"Video showing a configuration of Generator within PhET Studio. The user moves an element in the sim, then clicks save.","phetStudioOverview.features.needToChangeAPresetBut":"Need to change a preset, but you’ve already shared the link? Simply open that preset in Studio, make your edits, and save it. The link will reflect the new state almost immediately the next time the preset is loaded!","phetStudioOverview.features.differentiationMadeEasy":"Differentiation Made Easy","phetStudioOverview.features.differentiationMadeEasyVideoAltText":"Video showing a configuration of Center and Variability within PhET Studio. The user clicks a checkbox, then clicks Save As, then saves the preset as a new version.","phetStudioOverview.features.notAllStudentsStart":"Not all students start at the same place, so why should your sims? With PhET Studio, you can easily clone presets to make unique versions for unique experiences. Scaffolding lessons just got a lot easier.","phetStudioOverview.features.noCodeConvenience":"No-code Convenience","phetStudioOverview.features.noCodeConvenienceVideoAltText":"Video showing Calculus Grapher within PhET Studio. The user clicks on the options menu, hides some screens by clicking checkboxes, clicks simulation settings, adjusts two settings, then clicks save.","phetStudioOverview.features.theAdvanceOptionsMenuAllows":"The advanced options menu in PhET Studio allows you to conveniently control the screens visible to students and save sim preferences such as language, regional portrayals, audio, default units, representations, and more!","phetStudioOverview.features.findOnlineUseAnytime":"Find Online, Use Anytime","phetStudioOverview.features.findOnlineUseAnytimeAltText":"Video showing My Presets on the My PhET Page. The user clicks import from url, pastes a preset url, and clicks import.","phetStudioOverview.features.importAPresetThatSomeoneElse":"With PhET Studio, you can easily import a preset that someone else created, make your own edits, and organize it within your personalized collection of presets found on your <a {{0}}>My PhET</a> page.","phetStudioOverview.features.comingSoonNarrow":"Coming Soon: Narrow the focus. Expand the learning.","phetStudioOverview.features.comingSoonNarrowAltText":"Video showing a circuit setup and the user hiding the element toolbox.","phetStudioOverview.features.meetTheNeedsOfAllLearners":"Meet the needs of all learners by giving your students only the tools they need. With PhET Studio, you will be able to disable and hide areas of the sim, then save your unique preset to use with your students.","phetStudioOverview.features.expectedIn2026":"Expected in 2026."}}},pricing:{"PhetStudioOverviewPricingPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p;n.export({PhetStudioOverviewPricingPanel:()=>h},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../../../api/strings/u