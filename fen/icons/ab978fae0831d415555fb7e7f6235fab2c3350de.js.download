ators.title":"For Translators","forTranslators.mission.heading":"Mission","forTranslators.html5Simulations.heading":"HTML5 Simulations","forTranslators.html5Simulations.translationUtilityLink":"HTML5 Translation Utility","forTranslators.website.heading":"Website","forTranslators.website.translationUtilityLink":"Website Translation Utility","forTranslators.teacherTips.heading":"Teacher Tips","forTranslators.legacySimulations.heading":"Legacy Simulations","forTranslators.reportAnIssue.heading":"Report an Issue","forTranslators.mission.paragraph1":"Translating the English PhET simulations and resources greatly expands our audience, and helps us accomplish the <a {{href1}}>PhET mission</a>. We welcome individuals with expertise in math and science teaching to help us grow our users around the world and add to our expanding collection of <a {{href2}}>translated sims</a>.","forTranslators.mission.paragraph2":"While anyone may independently translate PhET resources (see below), the PhET Translator Network provides focused support and recognition as part of a facilitated community of translators. <a {{href}}>Learn more and apply here</a>.","forTranslators.html5Simulations.paragraph1":"PhET HTML5 sims are easily translated through a web browser. Access to the HTML5 Translation Utility is limited to trusted translators. <a {{href1}}>Request trusted translator access</a>. All of our translators are credited here: <a {{href2}}>HTML5 simulation translation credits</a>.","forTranslators.website.paragraph1.v2":"This website has been written so that it is easily translated, offers instant previews of the translated result, and requires no programming skills. Most website translations are completed by a team of collaborating translators. Access to the Website Translation Utility is limited to trusted translators. <a {{href}}>Request trusted translator access</a>.","forTranslators.teacherTips.paragraph1":"The Teacher Tips associated with every sim can be translated by editing the original .pdf document and emailing a .pdf to phethelp@colorado.edu for publication on the website. <a {{href}}>Instructions for translating PhET Teacher Tips</a>.","forTranslators.legacySimulations.paragraph1":"PhET Java simulations have been written so that they are easily translated. The process uses a simple tool called the <a {{href}}>Legacy Translation Utility</a>, and requires no programming skills.","forTranslators.reportAnIssue.paragraph1":"Have you noted a translation error, such as a word used in an inappropriate context? If so, please report it in this <a {{href}}>form</a>.","forTranslators.signInToAccess":"Sign In to Access","forTranslators.notATrustedTranslator":"You are not a trusted translator. Access to the HTML5/Website translation utility is limited to trusted translators."}}},"help-center":{"getting-started":{"HelpCenterGettingStartedPage.tsx":function(e,t,n){let i;n.export({HelpCenterGettingStartedPage:()=>o},!0),n.link("../../../../../api/data/constants",{OPTIONAL_METEOR_PREFIX(e){i=e}},0);let o=()=>"";o.getLink=e=>`${i}/${e}/help-center/getting-started`}},"quick-tips":{"HelpCenterQuickTipsPage.tsx":function(e,t,n){let i;n.export({HelpCenterQuickTipsPage:()=>o},!0),n.link("../../../../../api/data/constants",{OPTIONAL_METEOR_PREFIX(e){i=e}},0);let o=()=>"";o.getLink=e=>`${i}/${e}/help-center/quick-tips`}},"running-sims":{"HelpCenterRunningSimsPage.tsx":function(e,t,n){let i;n.export({HelpCenterRunningSimsPage:()=>o},!0),n.link("../../../../../api/data/constants",{OPTIONAL_METEOR_PREFIX(e){i=e}},0);let o=()=>"";o.getLink=(e,t)=>`${i}/${e}/help-center/running-sims${(null==t?void 0:t.panel)?`/${t.panel}`:""}${(null==t?void 0:t.question)?`#${t.question}`:""}`}}},"inclusive-design":{about:{"InclusiveDesignAboutPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d;n.export({InclusiveDesignAboutPanel:()=>p},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../../api/data/constants",{IMG_ROOT(e){o=e},OPTIONAL_METEOR_PREFIX(e){r=e}},1),n.link("../../../