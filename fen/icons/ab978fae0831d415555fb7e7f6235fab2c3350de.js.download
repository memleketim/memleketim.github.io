put",titleString:t.accessibility.prototypes.cameraInput,descriptionString:t.accessibility.prototypes.cameraInputText,question:S,answer:P},{key:"custom-gesture",titleString:t.accessibility.prototypes.customGesture,descriptionString:t.accessibility.prototypes.customGestureText,question:k,answer:E},{key:"sound-and-sonification",titleString:t.accessibility.prototypes.sonification,descriptionString:t.inclusiveDesign.features.theSoundAndSonificationFeatureUses,question:w,answer:T},{key:"voicing",titleString:t.accessibility.prototypes.voicing,descriptionString:t.inclusiveDesign.features.theVoicingFeatureGives,question:O,answer:I},{key:"interactive-description",titleString:t.accessibility.prototypes.fullDescription,descriptionString:t.accessibility.prototypes.fullDescriptionText,question:C,answer:L},{key:"interactive-description-ios",titleString:t.accessibility.prototypes.mobileA11yTitle,descriptionString:t.inclusiveDesign.features.forSomeSimulationsTheInteractiveDescription,question:j,answer:x},{key:"zoom-and-magnification",titleString:t.accessibility.prototypes.zoomAndMagnificationTitle,descriptionString:t.inclusiveDesign.features.thePanAndZoomFeatureEnablesAnyone,question:A,answer:N},{key:"interactive-highlights",titleString:t.accessibility.prototypes.interactiveHighlights,descriptionString:t.accessibility.prototypes.interactiveHighlightsText,question:D,answer:M}];return R=R.sort((e,t)=>g.featureOrderComparator(e.key,t.key)),i.createElement("div",{className:"inclusive-design-tab-features"},i.createElement("section",{className:"section opening-section"},i.createElement("h2",{className:"h2"},t.inclusiveDesign.features.inclusiveFeatures),i.createElement("p",{className:"p"},i.createElement(m,{string:t.inclusiveDesign.features.inclusiveFeaturesEnableASimulation})),i.createElement("div",{className:"video"},i.createElement("iframe",{title:"YouTube video player",src:e.startsWith("es")?"https://www.youtube-nocookie.com/embed/9GXzVL5uO70":"https://www.youtube-nocookie.com/embed/7YrkpfQrbW8",frameBorder:"0",allow:"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",allowFullScreen:!0}))),R.map(e=>{var t,o;return i.createElement("section",{className:"section",key:e.key},i.createElement(f,{icon:`a11y-${e.key}.png`,titleString:e.titleString,descriptionString:e.descriptionString}),i.createElement(u,{data:[(t=function(e){for(var t=1;t<arguments.length;t++){var n=null!=arguments[t]?arguments[t]:{},i=Object.keys(n);"function"==typeof Object.getOwnPropertySymbols&&(i=i.concat(Object.getOwnPropertySymbols(n).filter(function(e){return Object.getOwnPropertyDescriptor(n,e).enumerable}))),i.forEach(function(t){var i;i=n[t],t in e?Object.defineProperty(e,t,{value:i,enumerable:!0,configurable:!0,writable:!0}):e[t]=i})}return e}({},e),o=o={ref:n[e.key]},Object.getOwnPropertyDescriptors?Object.defineProperties(t,Object.getOwnPropertyDescriptors(o)):(function(e,t){var n=Object.keys(e);if(Object.getOwnPropertySymbols){var i=Object.getOwnPropertySymbols(e);n.push.apply(n,i)}return n})(Object(o)).forEach(function(e){Object.defineProperty(t,e,Object.getOwnPropertyDescriptor(o,e))}),t)]}))}),i.createElement("section",{className:"section"},i.createElement("h2",{className:"h2"},t.inclusiveDesign.features.knownIssues),i.createElement("p",{className:"p"},i.createElement(m,{string:t.inclusiveDesign.features.weAreBuildingInclusive,interpolatedValues:[l("https://github.com/phetsims/qa/blob/main/documentation/accessibility-bugs.md")]}))))},path:"features",getLink:e=>`${a}/${e}/inclusive-design/features`}},"inclusiveDesignFeaturesPanelStrings.json":function(e,t,n){n.exports={"inclusiveDesign.features.systemRequirements":"System Requirements","inclusiveDesign.features.scenarios":"Scenarios","accessibility.prototypes.aboutAlternativeInput":"More About Alternative Input","inclusiveDesign.features.tipsAboutAlternativeInput":"Tips about alternative input:","inclusiveDesign.features.easilyTrackWhatObject":"Easily track what object you are interacting with by following the bright pink highlight as you navigate.","inclusiveDesign.features.doWhatYouExpect":"Do what you expect to do as you navigate to objects. Basic actions like buttons, checkboxes, and sliders follow standard action patterns. We provide instructions right in the sim when we need to design custom (non-standard) actions.","inclusiveDesign.features.checkOutTheKeyboardShortcuts":"Check out the Keyboard Shortcuts dialog for help with all types of actions available in the sim. We often design extra shortcuts to improve efficiency when using alternative input methods.","inclusiveDesign.features.theAlternativeInputFeatureShould":"The Alternative Input feature should work on any platform. If your input device or method is not working with a PhET simulation, let us know.","inclusiveDesign.features.forYoungLearnersDevelopingAgility":"For young learners developing agility with a mouse, using a keyboard may be easier.","inclusiveDesign.features.forTeachersDoingSimDemos":"For teachers doing sim demos, keyboard shortcuts may make navigating more efficient, and the focus highlights can help students follow the visible points of action.","inclusiveDesign.features.forBlindAndVisuallyImpaired":"For blind and visually impaired learners using a keyboard is often essential to navigate and interact. Sims that include Interactive Description or Voicing always include Alternative Input.","inclusiveDesign.features.trySimulationsWithTheAlternativeInputFeatureLink":"Try simulations with the <a {{0}}>Alternative Input feature</a>.","inclusiveDesign.features.moreAboutCameraInput":"More About Camera Input","inclusiveDesign.features.thisFeatureIncreasesTheFileSize":"This feature increases the file size of the simulation and requires an active internet connection during loading. It may have slow performance on less powerful devices. Note: No images are stored or recorded when using this feature.","inclusiveDesign.features.setUpSteps":"Set-up Steps:","inclusiveDesign.features.useTheSimulationsUrl":"Use the simulation’s URL plus the query parameter, “?cameraInput=hands”. This downloads the files needed to load the feature for the simulation. These are the files that enable recognition of hand orientation.","inclusiveDesign.features.yourCameraShouldActivateAnd":"Your camera should activate, and you should be ready to explore simulation interaction with your hands. If not, check your browser’s camera permissions.","inclusiveDesign.features.toMakeAdjustmentsSeeThe":"To make adjustments, see the Input tab in the Preferences menu.","inclusiveDesign.features.toDisplayYourVideoWithThe":"To display your video with the simulation, append “&showVideo” to the URL.","inclusiveDesign.features.trySimulationsWithTheCameraInputFeatureLink":"Try simulations with the <a {{0}}>Camera Input feature</a>.","inclusiveDesign.features.moreAboutCustomGesture":"More About Custom Gesture","inclusiveDesign.features.tipsAboutCustomGesture":"Tips about custom gesture:","inclusiveDesign.features.onTouchDevicesEasilyTrack":"On touch devices, easily track what object you are interacting with without obscuring the screen.","inclusiveDesign.features.followTheBrightPinkHighlight":"Follow the bright pink highlight as you swipe left or right to navigate to interactive objects (and reading blocks with the Voicing feature enabled).","inclusiveDesign.features.doubleTapOnInteractiveObjects":"Double tap on interactive objects (and reading blocks with the Voicing enabled) to activate basic actions like buttons and checkboxes, or to get special instructions for dragging interactions like sliders and movable objects.","inclusiveDesign.features.warningCustomGesture":"<strong>Warning:</strong> When enabled, learners can no longer use regular pointer-based taps and drags. Turn the feature off to return to regular taps and drags.","inclusiveDesign.features.theCustomGestureFeatureWhen":"The Custom Gesture feature, when available, can be enabled on touch devices. It pairs well with the voicing feature and with voicing enabled custom gesture can support diverse learners including learners with who are blind or visually impaired.","inclusiveDesign.features.forTeachersDoingSimDemosOnSmaller":"For teachers doing sim demos on smaller touch devices or perhaps even a smart board, custom gestures can provide a way to use the sim without obscuring the screen. Simple swipes and double taps make navigating and interacting easy without directly covering the screen with your hand or body. The focus highlights help students follow the visible points of action.","inclusiveDesign.features.forBlindAndVisuallyImpairedLearnersPairing":"For blind and visually impaired learners pairing the custom gesture feature with the voicing feature provides an alternative to using traditional screen reader software.","inclusiveDesign.features.weCurrentlyDoNotHave":"We currently do not have any published simulations with this feature. Check <a {{0}}>inclusive prototypes</a> for this feature.","accessibility.prototypes.aboutSonification":"More About Sounds and Sonification","inclusiveDesign.features.tipsAndResourcesForSoundAndSonification":"Tips and resources for sound and sonification:","inclusiveDesign.features.soundsAreEnabledByDefault":"Sounds are enabled by default and can be turned off using the All Audio On/Off button in the navigation bar or through the Preferences menu.","inclusiveDesign.features.sometimesWeDesignAdditionalSound":"Sometimes we design additional sound effects or sonifications that are helpful for some individuals or situations.These additional sounds are included in the simulation as Extra Sounds, and can be enabled in the Audio tab of the Preferences menu.","inclusiveDesign.features.seeTheTeachingResourcesTab":"See the Teaching Resources tab on the simulation page for the Sound Features video, which provides a brief overview of the specific Sounds and Sonification available in that simulation.","inclusiveDesign.features.thisFeatureUsesWebAudio":"This feature uses Web Audio, which is supported by most browsers. If you are not hearing sounds when you expect to, try pressing the Reset All button in the simulation, refreshing the page, or updating your web browser to the latest version.","inclusiveDesign.features.forLearnersWithLearningOrCognitive":"For learners with learning or cognitive differences, sounds with visuals may help with focus and making connections.","inclusiveDesign.features.forOnlineLearningContextsSounds":"For online learning contexts, sounds can be very helpful to keep learners engaged.","inclusiveDesign.features.forLearnersWhoRelyOnA":"For learners who rely on a described experience, Sounds and Sonification augment the amount of detail that can be perceived through auditory means.","inclusiveDesign.features.trySimulationsWithTheSoundAndSonificationFeatureLink":"Try simulations with the <a {{0}}>Sound and Sonification feature</a>.","accessibility.prototypes.aboutVoicing":"More About Voicing","inclusiveDesign.features.theVoicingFeatureCanBeTurned":"The Voicing feature can be turned on and customized from the sim Preferences Menu.","inclusiveDesign.features.onceEnabledNamesOfInteractive":"Once enabled, names of interactive objects and controls are voiced by default, and important on-screen text is made voice-able through interactive reading blocks. Through the Preferences menu, you can add more information to voice as you interact. You can add object details and changes, surrounding context changes, and helpful hints.","inclusiveDesign.features.thisFeatureUsesWebSpeechTechnology":"This feature uses Web Speech technology to deliver the Voicing. Web Speech is supported by most browsers. If you are not hearing the Voicing description when you expect to, try refreshing the page or updating your web browser to the latest version.","inclusiveDesign.features.theVoicingFeatureIncludesAnOptional":"The Voicing feature includes an optional Toolbar that appears along the left side of the simulation when Voicing is enabled. The Toolbar provides on-demand access to an overview, details about the current state of the simulation, and a hint to get started.","inclusiveDesign.features.aModernBrowserThatSupportsWeb":"A modern browser that supports Web Speech such as the latest versions of Chrome, Firefox, or Safari. Other browsers may work.","inclusiveDesign.features.theVoicingFeatureIsNotDesigned":"The Voicing feature is not designed to be used simultaneously with screen reader software. When a screen reader is in use, once a learner enables Voicing they may want to temporarily turn off their screen reader software.","inclusiveDesign.features.onTouchDevicesTheVoicingSystemRequirements":"On touch devices, the Voicing feature pairs well with the Custom Gesture feature (when available) to create an accessible interactive described experience similar to but different from the iOS VoiceOver experience.","inclusiveDesign.features.thereAreLearnersWithDiverse":"There are learners with diverse needs in a classroom. The teacher is using a PhET sim on an interactive white board and asking predictive questions. The teacher has enabled the Interactive Highlights and Voicing features to support a learner who has a vision impairment. The highlights and spoken feedback seem to also support two learners who have trouble focusing, a learner with dyslexia, and a learner who is learning English.","inclusiveDesign.features.learnersHaveBeenDividedInto":"Learners have been divided into groups to use a sim to explore a concept. They have been tasked to play with the sim, and to collaboratively discuss and answer questions on a worksheet. A learner with a vision impairment who often works independently with their screen reader and headphones is able to actively work with their group of peers using the Voicing feature and their keyboard.","inclusiveDesign.features.onTouchDevicesTheVoicing":"On touch devices the Voicing feature can be paired with the Custom Gesture feature to enable similar inclusive collaborations.","inclusiveDesign.features.trySimulationsWithTheVoicingFeatureLink":"Try simulations with the <a {{0}}>Voicing feature</a>.","accessibility.prototypes.aboutDescriptions":"More About Interactive Description","inclusiveDesign.features.screenReaderSoftwareIsRequired":"Screen reader software is required to access the Interactive Description feature. Screen reader software and browser support changes frequently. We recommend the following combinations, but this may change and other combinations may work well:","inclusiveDesign.features.nvdaAndFirefoxOnWindows":"NVDA and Firefox on Windows","inclusiveDesign.features.jawsAndChromeOnWindows":"JAWS and Chrome on Windows","inclusiveDesign.features.voiceOverAndSafariOrChromeOnMacOs":"VoiceOver and Safari or Chrome on Mac OS","inclusiveDesign.features.toGetASenseOfWhatIsAvailable":"To get a sense of what is available, a learner uses their familiar screen reader commands or the Arrow keys to read through the current state. They may also use screen reader commands or the Tab key to look for things that are interactive. Once focused on an interactive object, they use standard key presses to make changes. They hear responses about relevant changes and make decisions about what to do next. They may make more changes, they may investigate the current state for details that might have already changed. They may share and discuss their findings with a peer.","inclusiveDesign.features.aTeacherWhoWantsToSee":"A teacher who wants to see what descriptions are available without using screen reader software can refer to that simulation’s Teacher Tips for a link to the A11y View. The A11y View displays description content for a simulation. The A11y View is a tool for teachers and designers; it is not intended for learners.","inclusiveDesign.features.trySimulationsWithTheInteractiveDescriptionFeatureLink":"Try simulations with the <a {{0}}>Interactive Description feature</a>.","inclusiveDesign.features.moreAboutInteractiveDescriptionOnMobileDevices":"More About Interactive Description on Mobile Devices","inclusiveDesign.features.interactiveDescriptionMobileLink":"This feature is introduced and demonstrated in the <a {{0}}>Interactive Description</a> video.","inclusiveDesign.features.voiceOverOnIosIsRequired":"VoiceOver on iOS is required to access the Interactive Description feature on iPhones and iPads. This feature is not tested on other mobile platforms. We recommend the following combination, but keep in mind this may change and other combinations may work well:","inclusiveDesign.features.voiceOverAndSafariOn":"VoiceOver and Safari on iOS (iPad or iPhone)","inclusiveDesign.features.aLearnerUsingMobileVoiceOver":"A learner using mobile VoiceOver comes to a simulation with mobile accessible interactive description. They use a 3-finger swipe up to read from the top. They get a sense of what is available and then use standard VoiceOver gestures to interact and make changes. They hear responses about relevant changes. They then make decisions on what to do next. They may make more changes, they may investigate the current state for details of how it has already changed.","inclusiveDesign.features.trySimulationsWithTheInteractiveDescriptionFeatureOnMobileDevicesLink":"Try simulations with the <a {{0}}>Interactive Description feature on Mobile Devices</a>.","inclusiveDesign.features.moreAboutPanAndZoom":"More About Pan and Zoom","inclusiveDesign.features.thePanAndZoomFeatureShouldWork":"The Pan and Zoom feature should work on any platform. Use pinch-to-zoom and drag gestures on touch devices, and when using a keyboard, use the standard keyboard shortcuts (Mac: Command +/-/0, Windows: Ctrl +/-/0). The commands available through the browser drop-down menu will not work. In some cases you need to make a click or press the Tab key to release the Arrow keys for panning.","inclusiveDesign.features.aLearnerUsingAMobilePhone":"A learner using a mobile phone has trouble interacting with a slider. They pinch to zoom in, make the fine adjustments they desire and zoom out to assess what happened.","inclusiveDesign.features.aLearnerWithLowVisionUsing":"A learner with low vision using a desktop platform and a large monitor has trouble seeing the detail they need. They zoom in using the standard zoom-in keyboard commands and get the detail they need.","inclusiveDesign.features.trySimulationsWithThePanAndZoomFeatureLink":"Try simulations with the <a {{0}}>Pan and Zoom feature</a>.","inclusiveDesign.features.moreAboutInteractiveHighlights":"More About Interactive Highlights","inclusiveDesign.features.thereAreNoPlatformSpecificRequirements":"There are no platform specific requirements.","inclusiveDesign.features.forLearnersWithLowVisionInteractive":"For learners with low vision, interactive highlights can be helpful as they make interactive objects stand out. This feature is often used in conjunction with Pan and Zoom and Voicing when they are available.","inclusiveDesign.features.forFeachersDoingSimDemosInteractive":"For teachers doing sim demos, Interactive Highlights can draw attention and focus from students.","inclusiveDesign.features.trySimulationsWithTheInteractiveHighlightsFeatureLink":"Try simulations with the <a {{0}}>Interactive Highlights feature</a>.","inclusiveDesign.features.inclusiveFeatures":"Inclusive Features","inclusiveDesign.features.inclusiveFeaturesEnableASimulation":"Inclusive features enable a simulation to flex and adapt to meet the needs of diverse learners and contexts. <strong>Note:</strong> Not all inclusive features are available in every sim, and not all features are needed to support every individual learner.","accessibility.prototypes.alternativeInput":"Alternative Input","accessibility.prototypes.cameraInput":"Camera Input","accessibility.prototypes.customGesture":"Custom Gesture","accessibility.prototypes.sonification":"Sound and Sonification","accessibility.prototypes.voicing":"Voicing","accessibility.prototypes.fullDescription":"Interactive Description","accessibility.prototypes.mobileA11yTitle":"Interactive Description on Mobile Devices","accessibility.prototypes.zoomAndMagnificationTitle":"Pan and Zoom","accessibility.prototypes.interactiveHighlights":"Interactive Highlights","inclusiveDesign.features.alternativeInputEnablesLearners":"Alternative Input enables learners to use many different input methods beyond mouse, touch and trackpad to interact with a sim. These include keyboard, switches, joysticks, and many more","accessibility.prototypes.cameraInputText":"Camera Input enables interaction with the simulation using openly-licensed image recognition software that can identify your hands or specific objects. Use a webcam or computer camera to recognize hand movements or colored objects placed within camera view to interact with objects in the simulatio","accessibility.prototypes.customGestureText":"Custom gesture is an alternative focus-based input method designed for touch devices. When available, it can be found and activated in the Input tab of the Preferences menu. When enabled, learners navigate and interact using custom focus-based swipes and double taps. Enabling custom gesture disables regular pointer-based taps and drags.","inclusiveDesign.features.theSoundAndSonificationFeatureUses":"The Sound and Sonification feature uses non-speech sound to create an immersive and meaningful experience for learners, including those with vision impairments. Sonifications are sounds such as musical tones that are carefully mapped to changing values in the simulation. This creates auditory access to mathematics and science concepts. Sound effects are sounds that help learners make connections with the real world (e.g. a rubbing sound when rubbing a foot on a carpet). Sounds are also used to indicate successful interaction such as pressing a button or checking a checkbox","inclusiveDesign.features.theVoicingFeatureGives":"The Voicing feature gives all learners the option to experience spoken information about the simulation as they navigate and interact. This feature is customisable and can be used by a diverse range of learners including learners who have trouble reading text, or who have trouble seeing or interpreting what is visually displayed. Voicing is enabled from the Preferences Menu under the Audio tab.","accessibility.prototypes.fullDescriptionText":"The Interactive Description feature, accessed using screen reader software, provides an interactive described experience that dynamically updates and automatically responds to changes you make as you interact. The designed descriptions are embedded in the sim, and are automatically accessed with your screen reader software technology. With standard key presses (or iOS mobile VoiceOver gestures) you have constant on-demand access to a description of the current state, and you can hear descriptions of relevant changes in real time as you engage with objects and make changes","inclusiveDesign.features.forSomeSimulationsTheInteractiveDescription":"For some simulations the Interactive Description feature is also available on iOS devices using mobile VoiceOver (iPhones and iPads).","inclusiveDesign.features.thePanAndZoomFeatureEnablesAnyone":"The Pan and Zoom feature enables anyone to zoom in for a closer look. On touch devices, learners can pinch-to-zoom and drag to pan around the screen. On other devices, use keyboard shortcuts (Mac: Command +/-, Windows: Ctrl +/-) or pan to an area for close examination using arrow keys. The simulation automatically pans to keep the focused item in view when using a keyboard","accessibility.prototypes.interactiveHighlightsText":"Bright pink Interactive Highlights, the same as the highlights seen when using Alternative Input, can be enabled for mouse and touch interaction. To find and activate Interactive Highlights, open the Preferences menu and look for the Visual tab.","inclusiveDesign.features.knownIssues":"Known Issues","inclusiveDesign.features.weAreBuildingInclusive":"We are building inclusive features that exist along the cutting edge of web technologies. This design space constantly changes. Software updates to browsers, operating systems, and assistive technologies can create new pathways for diverse use, and sometimes can introduce issues that block productive use of an inclusive feature. We track several accessibility bugs in our QA documentation under <a {{0}}>Known Accessibility Bugs</a>."}}},knowledge:{"InclusiveDesignKnowledgePanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m;n.export({InclusiveDesignKnowledgePanel:()=>d},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../../api/data/constants",{IMG_ROOT(e){o=e}},1),n.link("../../../../../api/strings/useStrings",{useStrings(e){r=e}},2),n.link("../../../../../api/urlUtils.js",{getInlineHref(e){a=e}},3),n.link("../../../../components/appStoreBadges/googlePlayStoreBadge/GooglePlayStoreBadge",{GooglePlayStoreBadge(e){s=e}},4),n.link("../../../../components/phetCard/PhetCard",{PhetCard(e){l=e}},5),n.link("../../../../components/richString/RichString",{RichString(e){c=e}},6),n.link("../../LocaleContext",{useLocale(e){u=e}},7),n.link("./inclusiveDesignKnowledgePanelStrings.json",{default(e){m=e}},8);let d={panel:()=>{let e=r(m),t=u(),n=t=>i.createElement(l,{title:t.titleString,headerType:"h3",imageUrl:`${o}/${t.image}`,text:t.contentString,linkUrl:t.url,linkText:e.inclusiveDesign.knowledge.takeThisCourse,sectionClassName:"coursera-course"});return i.createElement("div",{className:"inclusive-design-tab-knowledge"},i.createElement("section",{className:"section opening-section"},i.createElement("h2",{className:"h2"},e.inclusiveDesign.knowledge.inclusiveDesignResearch),i.createElement("p",{className:"p"},e.inclusiveDesign.knowledge.asWeDesignInclusiveFeatures)),i.createElement("section",{className:"section"},i.createElement("h2",{className:"h2"},e.inclusiveDesign.knowledge.inclusiveDesignCourseOfferings),i.createElement(n,{titleString:e.inclusiveDesign.knowledge.descriptionDesignForInteractiveLearningResources,image:"coursera-description-design.png",contentString:e.inclusiveDesign.knowledge.thisCourseGivesYouEasyAccess,url:"https://www.coursera.org/learn/description-design-for-interactive-learning-resources"}),i.createElement(n,{titleString:e.inclusiveDesign.knowledge.soundAndSonificationDesignForInteractiveLearningTools,image:"coursera-sound-sonification.png",contentString:e.inclusiveDesign.knowledge.inThisCourseWeWillIntroduce,url:"https://www.coursera.org/learn/sound-and-sonification-for-learning"})),i.createElement("section",{className:"section"},i.createElement("h2",{className:"h2"},e.inclusiveDesign.knowledge.publicationsAndPresentations),i.createElement("p",{className:"p"},i.createElement(c,{string:e.inclusiveDesign.knowledge.comingSoonSeePublicationsThrough2020,interpolatedValues:[a(`/${t}/accessibility/research#publications-header`)]}))),i.createElement("section",{className:"section"},i.createElement("h2",{className:"h2"},e.inclusiveDesign.knowledge.otherResourcesOrProjects),i.createElement(l,{title:e.inclusiveDesign.knowledge.hapticsPlayground,headerType:"h3",imageUrl:`${o}/haptics-playground.png`,text:e.inclusiveDesign.knowledge.hapticsPlaygroundDescription,linkObject:i.createElement(s,{appId:"edu.colorado.phet.hapticsPlayground",skipCampaignId:!0}),sectionClassName:"coursera-course"})))},path:"knowledge"}},"inclusiveDesignKnowledgePanelStrings.json":function(e,t,n){n.exports={"inclusiveDesign.knowledge.inclusiveDesignResearch":"Inclusive Design Research","inclusiveDesign.knowledge.asWeDesignInclusiveFeatures":"As we design inclusive features, we conduct research that investigates how students learn with inclusive features and evaluates our designs. We share our findings, design processes, methods, and describe our inclusive features and software architecture. We apply what we learn about inclusive design to evolve our own simulation design processes, and share our knowledge with a multidisciplinary community of researchers, designers, software developers, and STEM educators, through courses, academic and general articles, and presentations.","inclusiveDesign.knowledge.inclusiveDesignCourseOfferings":"Inclusive Design Course Offerings","inclusiveDesign.knowledge.descriptionDesignForInteractiveLearningResources":"Description Design for Interactive Learning Resources","inclusiveDesign.knowledge.thisCourseGivesYouEasyAccess":"This course gives you easy access to an innovative description design framework used and created by experts in description design who design descriptions for highly interactive learning resources.","inclusiveDesign.knowledge.takeThisCourse":"Take This Course","inclusiveDesign.knowledge.soundAndSonificationDesignForInteractiveLearningTools":"Sound and Sonification Design for Interactive Learning Tools","inclusiveDesign.knowledge.inThisCourseWeWillIntroduce":"In this course we will introduce you to sound and sound design, to help you successfully integrate enjoyable and effective sounds into interactive learning tools.","inclusiveDesign.knowledge.publicationsAndPresentations":"Publications & Presentations","inclusiveDesign.knowledge.comingSoonSeePublicationsThrough2020":"Coming soon! See <a {{0}}>Publications through 2020.</a>","inclusiveDesign.knowledge.otherResourcesOrProjects":"Other Resources or Projects","inclusiveDesign.knowledge.hapticsPlayground":"Haptics Playground","inclusiveDesign.knowledge.hapticsPlaygroundDescription":"Haptics Playground is an Android app available in the Google Play Store. This tool is an outcome of our haptics work and is a useful design tool. In collaboration with the CHROME Lab at St. Louis University, we explored the use of vibratory feedback when using simulations on touch devices. We did some experimental prototyping on John Travoltage and Gravity Force Lab: Basics (not publicly available). The Haptics Playground allows you to explore and create vibratory haptic patterns that you might want to add to an interactive environment, like a PhET Simulation."}}},prototypes:{"InclusiveDesignPrototypesPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b;n.export({InclusiveDesignPrototypesPanel:()=>S},!0),n.link("react",{default(e){i=e},useEffect(e){o=e},useState(e){r=e}},0),n.link("../../../../../api/data/constants",{IMG_ROOT(e){a=e},OPTIONAL_METEOR_PREFIX(e){s=e}},1),n.link("../../../../../api/inclusiveDesign/inclusiveDesign",{InclusiveDesign(e){l=e}},2),n.link("../../../../../api/strings/useStrings",{useStrings(e){c=e}},3),n.link("../../../../../api/urlUtils",{getInlineExternalHref(e){u=e},getInlineHref(e){m=e},inlineHrefProps(e){d=e}},4),n.link("../../../../components/playButton/PlayButton",{PlayButton(e){p=e}},5),n.link("../../../../components/richString/RichString",{RichString(e){h=e}},6),n.link("../../../../components/spinner/Spinner",{Spinner(e){g=e}},7),n.link("../../LocaleContext",{useLocale(e){y=e}},8),n.link("./inclusiveDesignPrototypesPanelStrings.json",{default(e){f=e}},9),n.link("../../simulations/browseAndFilter/BrowseAndFilterPagePath",{getFilterPageUrl(e){b=e}},10);let v=e=>i.createElement("div",{className:"feature-with-text"},i.createElement("img",{src:`${a}/${e.icon}`,className:"feature-icon",alt:""}),i.createElement("p",{className:"p"},e.featureString,e.descriptionString?`: ${e.descriptionString}`:"")),S={panel:()=>{let e=c(f),t={hasa11yaltinput:{key:"alternative-input",featureString:e.accessibility.prototypes.alternativeInput,descriptionStringKey:"a11yaltinputtext"},hasa11ycamerainput:{key:"camera-input",featureString:e.accessibility.prototypes.cameraInput,descriptionStringKey:"a11ycamerainputtext"},hasa11ycustomgesture:{key:"custom-gesture",featureString:e.accessibility.prototypes.customGesture,descriptionStringKey:"a11ycustomgesturetext"},hasa11ysound:{key:"sound-and-sonification",featureString:e.accessibility.prototypes.sonification,descriptionStringKey:"a11ysoundtext"},hasa11yvoicing:{key:"voicing",featureString:e.accessibility.prototypes.voicing,descriptionStrin