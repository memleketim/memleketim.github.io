alityExplorerStringKey:()=>v,balanceQuestionsStringKey:()=>S,whatAreTheNewIconsStringKey:()=>P,whatAreExploreQuestionsStringKey:()=>k,forTeachersResourcesStringKey:()=>E,beforeYouStartWritingStringKey:()=>w,writingLearningGoalsStringKey:()=>T,asYouPlanYourLessonStringKey:()=>O,guidelinesForWritingLearningGoalsStringKey:()=>I,activityDesignGuidelinesStringKey:()=>C,startByLookingStringKey:()=>L,activitySheetOneStringKey:()=>j,activitySheetTwoStringKey:()=>x,activitySheetThreeStringKey:()=>A,finallyTimeToWriteStringKey:()=>N,writeYourLessonStringKey:()=>D,someFinalRemindersStringKey:()=>M,momentToReflectStringKey:()=>R,rateThisWorkshopStringKey:()=>F,nextWorkStringKey:()=>_,learnWhatMakesStringKey:()=>B,keepItShortStringKey:()=>W,useChallengePromptsStringKey:()=>K,includeStoppingPointsStringKey:()=>U,includeTeacherNotesStringKey:()=>H,allowExtraTimeStringKey:()=>q,reflectionRubricStringKey:()=>G,shareYourActivityStringKey:()=>Y,shareYourLessonStringKey:()=>$,feedbackFormStringKey:()=>z,MATH_FALLBACK_STRINGS:()=>V},!0);let i="virtualWorkshop.virtualWorkshopMath",o="virtualWorkshop.developStrategies",r="virtualWorkshop.designALessonPlan",a="virtualWorkshop.lectures",s="virtualWorkshop.discussionPrompts",l="virtualWorkshop.thoughThisWorkshop",c="virtualWorkshop.youWillDiscover",u="virtualWorkshop.whatDidYouNotice",m="virtualWorkshop.reflectOnLessonFlow",d="virtualWorkshop.simpleStructureLesson",p="virtualWorkshop.classroomNorms",h="virtualWorkshop.progressiveFormalization",g="virtualWorkshop.progressiveFormalizationPresentation",y="virtualWorkshop.twoStepEquations",f="virtualWorkshop.helpStudentsSeeStructure",b="virtualWorkshop.manipulateTheseSymbols",v="virtualWorkshop.playWithEqualityExplorer",S="virtualWorkshop.balanceQuestions",P="virtualWorkshop.whatAreTheNewIcons",k="virtualWorkshop.whatAreExploreQuestions",E="virtualWorkshop.forTeachersResources",w="virtualWorkshop.beforeYouStartWriting",T="virtualWorkshop.writingLearningGoals",O="virtualWorkshop.asYouPlanYourLesson",I="virtualWorkshop.guidelinesForWritingLearningGoals",C="virtualWorkshop.activityDesignGuidelines",L="virtualWorkshop.startByLooking",j="virtualWorkshop.activitySheetOne",x="virtualWorkshop.activitySheetTwo",A="virtualWorkshop.activitySheetThree",N="virtualWorkshop.finallyTimeToWrite",D="virtualWorkshop.writeYourLesson",M="virtualWorkshop.someFinalReminders",R="virtualWorkshop.momentToReflect",F="virtualWorkshop.rateThisWorkshop",_="virtualWorkshop.nextWork",B="virtualWorkshop.learnWhatMakes",W="virtualWorkshop.keepItShort",K="virtualWorkshop.useChallengePrompts",U="virtualWorkshop.includeStoppingPoints",H="virtualWorkshop.includeTeacherNotes",q="virtualWorkshop.allowExtraTime",G="virtualWorkshop.reflectionRubric",Y="virtualWorkshop.shareYourActivity",$="virtualWorkshop.shareYourLesson",z="virtualWorkshop.feedbackForm",V={[i]:"Virtual Workshop: Math",[o]:"Develop strategies for writing sim-based activities",[r]:"Design a lesson plan and activity sheet",[a]:"Lectures",[s]:"Discussion prompts",[l]:"Though this workshop was created for math educators, science teachers interested in using PhET simulations can also benefit from this workshop.",[c]:"In the first part of this workshop, you will discover and reflect on the learning benefits of playing with simulations through open play and reflection time. By the end of this section, you will have a strong understanding of how to leverage the design and scaffolding of a simulation to best support student inquiry and conceptual understanding.",[u]:"What did you notice? Below, listen to some responses from math teachers about their use with various sims.",[m]:"Reflect on Lesson Flow",[d]:"Reflect on the flow of the lesson you just experienced and how it was structured. There are many ways to teach using a PhET sim, but this lesson follows a simple structure that is easy to replicate:",[p]:"How might this flow work in your classroom? What classroom norms might need to be established?",[h]:"Progressive Formalization",[g]:"Dr. David Webb presents on progressive formalization and Equality Explorer, and how important progressive formalization is in the development of deep conceptual understanding.",[y]:"What are some strategies that you can use with two-step equations when you’re working with students?",[f]:"How can we help students see structure and meaning in these symbols?",[b]:"How can we help students develop meaningful strategies to manipulate these symbols?",[v]:"Play with the Equality Explorer simulation if you aren’t already familiar with it!",[S]:"As you’re putting things on the balance, what are some questions that come to mind?",[P]:"What are the new icons/controls offered on the Numbers screen?",[k]:"What are questions that could be explored?",[E]:'"For Teachers" Resources',[w]:"Before you get started writing your own lesson, it may help to look at how other educators have used your simulation. This section will introduce you to the resources available for teachers on the PhET website, including: sample learning goals, CCSS-alignment, and activities shared both by PhET and by other teachers.",[T]:"Writing Learning Goals",[O]:"As you get started planning your lesson, consider the technology you have available, and how much time you plan to take on the topic. Since PhET sims can be used to teach many topics covering many days of instruction, it is best to choose 2-3 learning goals for a single lesson plan. We recommend some specific strategies for writing learning goals.",[I]:"Guidelines for Writing Learning Goals",[C]:"Activity Design Guidelines",[L]:"Start by looking at the following activity sheets, and take notes on what you notice about the questions. Do you have any critiques? What do you like, or not like?",[j]:"Activity Sheet 1",[x]:"Activity Sheet 2",[A]:"Activity Sheet 3",[N]:"Finally, it is time to write your lesson! After you have spent some time working on your activity sheet and lesson plan with teacher facilitation notes, invite a colleague to look it over and give feedback.",[D]:"Write Your Lesson",[M]:"Some final reminders as you write your own lesson:",[R]:"After you have had a chance to teach with your lesson, take a moment to reflect on the parts that went well and what you would change.",[F]:"Please rate this workshop. We appreciate your feedback!",[_]:"Next, you’ll be working on #2-12 of the activity below.",[B]:"Learn what makes a PhET sim unique.",[W]:"Keep it short",[K]:"Use sim-focused challenge prompts and tables to scaffold student progress but support student autonomy",[U]:"Include explicit stopping points for students to discuss findings",[H]:"Include teacher notes with sample discussion questions",[q]:"Allow extra time for unexpected student discoveries",[G]:"Reflection Rubric",[Y]:"Share Your Activity",[$]:"After you have made your final lesson tweaks, don’t forget to share your lesson on the PhET website for the teacher community. If you’ve followed the guidelines in this workshop, your activity should earn a gold star.",[z]:"Feedback Form"}}},"math-activity-design":{"MathActivityDesignWorkshop.jsx":function(e,t,n){var i,o,r;let a,s,l,c,u,m;n.export({MathActivityDesignWorkshop:()=>d}),n.link("prop-types",{default(e){a=e}},0),n.link("react",{default(e){s=e}},1),n.link("../common/constants.ts",{MATH_ACTIVITY_DESIGN(e){l=e}},2),n.link("../common/VirtualWorkshop.jsx",{VirtualWorkshop(e){c=e}},3),n.link("./mathActivityDesignData.jsx",{MATH_ACTIVITY_DESIGN_DATA(e){u=e}},4),n.link("./mathActivityDesignStrings.ts",{MATH_ACTIVITY_DESIGN_FALLBACK_STRINGS(e){m=e}},5);class d extends(i=s.Component){render(){return s.createElement(c,{section:this.props.section,workshopType:l,title:u.title,sections:u.sections,strings:m})}constructor(e){super(e)}}o="propTypes",r={section:a.string},o in d?Object.defineProperty(d,o,{value:r,enumerable:!0,configurable:!0,writable:!0}):d[o]=r},"mathActivityDesignData.jsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v,S,P,k,E,w,T,O,I,C,L,j,x,A,N,D,M,R,F,_,B,W,K,U,H,q,G,Y,$,z,V,Q,J,Z,