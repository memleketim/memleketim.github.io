d strategies to craft a multi-year <a {{href}}>DEIB Strategic Plan</a> for revising and carrying out plans that ensure that our resources and programs are equity-aligned. PhET is actively monitoring the impact, feasibility, priority, and activity status of each of the following recommendations:","deib-in-stem-ed.strategy.recommendationsHeader":"Recommendations","deib-in-stem-ed.strategy.recommendation.list1.header":"Recommendation #1: Multi-Platform Access","deib-in-stem-ed.strategy.recommendation.list1.description":"All simulations should be updated to HTML5, and their performance should be tested against as many devices as reasonably possible, integrating Pinch-to-Zoom and double-tap to zoom into all simulations to ensure mobile accessibility.","deib-in-stem-ed.strategy.recommendation.list2.header":"Recommendation #2: Multi-Content Area Access","deib-in-stem-ed.strategy.recommendation.list2.description":"Simulations should provide wide and equal coverage of all math and science content areas.","deib-in-stem-ed.strategy.recommendation.list3.header":"Recommendation #3: Integrated Content Area Access","deib-in-stem-ed.strategy.recommendation.list3.description":"There should be many simulations developed to demonstrate cross-curricular connections among science, technology, engineering, and mathematics. Integration may occur within the simulation or its supporting resources.","deib-in-stem-ed.strategy.recommendation.list4.header":"Recommendation #4: Multiple Grade Level Access","deib-in-stem-ed.strategy.recommendation.list4.description":"There should be simulations with wide and equal coverage of all K-16 grade levels. When possible, simulations should allow for the choice of complexity levels through sim screens and customization. Sim-based teacher supports, such as Teacher Tips, should emphasize spiraling skill and knowledge levels, and how the sim can be used across grade levels.","deib-in-stem-ed.strategy.recommendation.list5.header":"Recommendation #5: Diversified Character Sets","deib-in-stem-ed.strategy.recommendation.list5.description":"Include fully diversified character sets and hand images, including options to localize sets.","deib-in-stem-ed.strategy.recommendation.list6.header":"Recommendation #6: Inclusive Features","deib-in-stem-ed.strategy.recommendation.list6.description":"The full suite of PhET simulations should meet <a {{href}}>web content accessibility guidelines</a>. All simulations should include relevant inclusive features (alternative input, sound and sonification, interactive description in English, pan and zoom, and voicing in English and local library languages).","deib-in-stem-ed.strategy.recommendation.list7.header":"Recommendation #7: Translation Features","deib-in-stem-ed.strategy.recommendation.list7.description":"Translation features should be available within simulations for all <a {{href}}>ISO-639</a> languages and be easy for users to find. Ideally, translated materials should be available for introductory videos and activities (ideally, including dual language options on closed captions).","deib-in-stem-ed.strategy.recommendation.list8.header":"Recommendation #8: Past and Present Contributions","deib-in-stem-ed.strategy.recommendation.list8.description":"All simulations should include resources for learning about the past and present contributions of diverse sets of individuals to the topic. Updates once every 5-10 years.","deib-in-stem-ed.strategy.recommendation.list9.header":"Recommendation #9: Career Connections","deib-in-stem-ed.strategy.recommendation.list9.description":"All simulations should include resources for learning about careers related to the topic. Updates once every 5-10 years.","deib-in-stem-ed.strategy.recommendation.list10.header":"Recommendation #10: Real-World Applications","deib-in-stem-ed.strategy.recommendation.list10.description":"All simulations should include resources and embedded examples of real-world scenarios or applications of concepts. Simulations provide information about “manipulatives ideas” for hands-on activities."}}},"DeibInStemEdRoutes.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f;function b(e){for(var t=1;t<arguments.length;t++){var n=null!=arguments[t]?arguments[t]:{},i=Object.keys(n);"function"==typeof Object.getOwnPropertySymbols&&(i=i.concat(Object.getOwnPropertySymbols(n).filter(function(e){return Object.getOwnPropertyDescriptor(n,e).enumerable}))),i.forEach(function(t){var i;i=n[t],t in e?Object.defineProperty(e,t,{value:i,enumerable:!0,configurable:!0,writable:!0}):e[t]=i})}return e}n.export({DeibInStemEdRoutes:()=>v},!0),n.link("react",{default(e){i=e}},0),n.link("../../../../api/strings/useStrings",{useStrings(e){o=e}},1),n.link("../../../components/stringSuspense/StringSuspense",{withStringSuspense(e){r=e}},2),n.link("../../../components/topicGroup/TopicGroupRoutes",{TopicGroupRoutes(e){a=e}},3),n.link("./advisors/DeibInStemEdAdvisorsPanel",{DeibInStemEdAdvisorsPanel(e){s=e}},4),n.link("./advisors/deibInStemEdAdvisorsPanelStrings.json",{default(e){l=e}},5),n.link("./commitment/DeibInStemEdCommitmentPanel",{DeibInStemEdCommitmentPanel(e){c=e}},6),n.link("./commitment/deibInStemEdCommitmentPanelStrings.json",{default(e){u=e}},7),n.link("./deibInStemEdRoutesStrings.json",{default(e){m=e}},8),n.link("./framework/DeibInStemEdFrameworkPanel",{DeibInStemEdFrameworkPanel(e){d=e}},9),n.link("./framework/deibInStemEdFrameworkPanelStrings.json",{default(e){p=e}},10),n.link("./programs/DeibInStemEdProgramsPanel",{DeibInStemEdProgramsPanel(e){h=e}},11),n.link("./programs/deibInStemEdProgramsPanelStrings.json",{default(e){g=e}},12),n.link("./strategy/DeibInStemEdStrategyPanel",{DeibInStemEdStrategyPanel(e){y=e}},13),n.link("./strategy/deibInStemEdStrategyPanelStrings.json",{default(e){f=e}},14);let v={page:r(b({},m,u,p,f,g,l),e=>{let t=o(m),n=[{label:t.deibInStemEd.tabNavigation.commitment,panel:c},{label:t.deibInStemEd.tabNavigation.framework,panel:d},{label:t.deibInStemEd.tabNavigation.strategy,panel:y