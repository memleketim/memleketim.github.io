line-link"},t.licensing.agreements.javaFlash)),o.createElement("li",null,o.createElement("a",{href:w.getLink(n),className:"inline-link"},t.licensing.agreements.activityContribution)))),o.createElement("section",{id:"support",className:"section"},o.createElement(d,null,t.licensing.support.header),o.createElement(p,null,o.createElement(h,{string:t.licensing.support.description1,interpolatedValues:[l(I.getLink(n))]})),o.createElement(m,null)))}),{getLink:e=>`${v}/${e}/licensing`})},"licensingPageStrings.json":function(e,t,n){n.exports={"licensing.title":"Licensing Information","licensing.commercialPartnerships.header":"Commercial Partnerships with PhET","licensing.commercialPartnerships.description":"Education technology companies, publishers, media libraries, and hardware providers are partnering with PhET to transform their educational products with PhET's award-winning collection of interactive simulations. A partnership provides additional benefits and services that help you to get the most out of the collection of simulations.","licensing.commercialPartnerships.learnMore":"Learn about commercial partnerships","licensing.teachWithPhet.header":"Using PhET Simulations in Teaching","licensing.teachWithPhet.description1":"Any students or educators (K-12, university, or continuing education) can use the simulations for free. You do not need to seek any further permissions from us.","licensing.teachWithPhet.description2":"All simulations available at <a {{0}}>https://phet.colorado.edu</a> are open educational resources and provided under the Creative Commons Attribution 4.0 license (<a {{1}}>CC BY 4.0</a>).The following attribution is required when sharing or redistributing a PhET simulation:","licensing.teachWithPhet.description3":"Simulation by PhET Interactive Simulations, University of Colorado Boulder, licensed under <a {{0}}>CC-BY-4.0</a> (<a {{1}}>https://phet.colorado.edu</a>).","licensing.teachWithPhet.description4":"See these <a {{0}}>best practices for attribution</a>.","licensing.researchWithPhet.header":"Using PhET Simulations for Research","licensing.researchWithPhet.description1":"Education research guides the design and classroom use of PhET simulations. Not only does the PhET team engage in education research directly, but we love to see PhET simulations being used by researchers worldwide to advance knowledge about teaching, learning, and assessment.","licensing.researchWithPhet.description2.item0":"Researchers are encouraged to use PhET simulations from <a {{0}}>https://phet.colorado.edu</a> in their work. These sims are openly licensed under the Creative Commons Attribution 4.0 license (<a {{1}}>CC BY 4.0</a>). No further permission is necessary to use the simulations in research provided two steps are followed:","licensing.researchWithPhet.description2.item1":"Include proper attribution when a simulation, or any derivative work (e.g. screenshot or video), appears in any education materials, presentations, journal articles, websites, or other channels you may use to distribute your work. Example attribution:","licensing.researchWithPhet.description2.item2":"Simulation by PhET Interactive Simulations, University of Colorado Boulder, licensed under <a {{0}}>CC-BY-4.0</a> (<a {{1}}>https://phet.colorado.edu</a>).","licensing.researchWithPhet.description2.item3":"After you complete your research, share your results with us. Please <a {{0}}>complete this form</a> for each article you publish.","licensing.researchWithPhet.description3":"Researchers interested in customizing simulations or collecting back-end data for use in learning engineering or learning analytics research may be interested in PhET’s interoperable simulations, our PhET-iO simulations. <a {{0}}>Learn more about PhET-iO</a>.","licensing.researchWithPhet.description4":"Education researchers in Africa are invited to participate in <a {{0}}>the webinar series being organized for the Mastercard Foundation</a>.","licensing.teacherSubmittedActivities.header":"Teacher-Submitted Activities","licensing.teacherSubmittedActivities.description1.item0":"A wide variety of <a {{0}}>teaching activities</a> have been contributed by the PhET team and its user community, and are available for you to adapt and use in your classroom. If an activity is marked as a contribution from the PhET team (as indicated by the presence of a PhET logo in the author field), it has been posted as a <a {{1}}>CC-BY</a> resource. For other activities, please contact the submitting author to affirm your use under a CC-BY license. The following attribution is required to share or redistribute CC-BY activities or adapted activities:","licensing.teacherSubmittedActivities.description1.item1":"Activity by [author] licensed under <a {{0}}>CC-BY-4.0</a> ([link to activity page]). <br/>OR","licensing.teacherSubmittedActivities.description1.item2":"This activity has been adapted from an activity by [author] licensed under <a {{0}}>CC-BY-4.0</a> ([link to original activity page]).","licensing.trademarks.header":"Use of PhET Name and Logo (beyond attribution)","licensing.trademarks.description1":"The PhET name and logo are registered trademarks of The Regents of the University of Colorado.","licensing.trademarks.description2":"Use of the PhET name and/or PhET logo for promotional, marketing, or advertising purposes requires a license agreement, and is included as part of our low-cost Basic Partnership. Learn more about our <a {{0}}>Partnership Program</a>.","licensing.phet-io.header":"PhET-iO Simulations","licensing.phet-io.description1":"PhET’s interoperable sims provide enhanced capabilities for interoperability with a wide variety of educational technology, including customization, streaming output data, and versatile API control. PhET-iO sims are a licensed product. <a {{0}}>Learn more about PhET-iO</a>.","licensing.sourceCode.header":"PhET Source Code","licensing.sourceCode.description1":"Most <a {{0}}>PhET simulation source code</a> is available under an open source license – either MIT or GPL. PhET-iO source code is not openly licensed.","licensing.agreements.header":"Full Text Agreements","licensing.agreements.html5":"HTML5 Software Agreement","licensing.agreements.javaFlash":"Java/Flash Software Agreement","licensing.agreements.activityContribution":"Activity Contribution Agreement","licensing.support.header":"Support PhET’s Work","licensing.support.description1":"PhET Interactive Simulations at the University of Colorado Boulder is a non-profit organization, reaching hundreds of millions of learners globally. Please support PhET with a tax-deductible <a {{0}}>donation</a> today!"}}},"my-phet":{"my-bookmarks":{"BookmarkNoteDisplay.tsx":function(e,t,n){let i,o,r,a,s,l;n.export({BookmarkNoteDisplay:()=>c},!0),n.link("react",{default(e){i=e},useState(e){o=e}},0),n.link("../../../../components/phetText/PhetText",{P(e){r=e}},1),n.link("../../activities/common/bookmarkModal/EditBookmarkNoteModal",{EditBookmarkNoteModal(e){a=e}},2),n.link("../../../../../api/strings/useStrings",{useStrings(e){s=e}},3),n.link("../../activities/common/bookmarkModal/editBookmarkNoteModalStrings.json",{default(e){l=e}},4);let c=e=>{let t=s(l),[n,c]=o(e.bookmark.note||""),[u,m]=o(!1);return i.createElement("div",{className:"note-display"},i.createElement(r,{className:"note-display-text"},n),i.createElement("button",{className:"edit-note-button","aria-label":t.activities.editBookmarkNoteModal.editNote,onClick:()=>{m(!0)}},"✏️"),i.createElement(a,{activityId:e.bookmark.activityId,noteText:n,setNoteText:c,isOpen:u,onRequestClose:()=>m(!1)}))}},"MyBookmarksPanel.tsx":function(e,t,n){let i,o,r,a,s,l,c,u,m,d,p,h,g,y,f,b,v,S,P,k,E,w,T,O,I;function C(e,t,n,i,o,r,a){try{var s=e[r](a),l=s.value}catch(e){n(e);return}s.done?t(l):Promise.resolve(l).then(i,o)}function L(e){return function(){var t=this,n=arguments;return new Promise(function(i,o){var r=e.apply(t,n);function a(e){C(r,i,o,a,s,"next",e)}function s(e){C(r,i,o,a,s,"throw",e)}a(void 0)})}}functi